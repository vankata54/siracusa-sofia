{
  "name": "siracusa-sofia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen": "node scripts/gen-menu.mjs && node scripts/gen-icons.mjs",
    "predev": "npm run gen",
    "dev": "astro dev",
    "prebuild": "npm run gen",
    "build": "astro build",
    "build:demo": "npm run gen && DEMO=1 astro build && node scripts/relativize.mjs dist",
    "serve": "node --experimental-strip-types --no-warnings server/index.ts",
    "db:migrate": "drizzle-kit generate",
    "db:seed": "node scripts/make-env.mjs && node --experimental-strip-types --no-warnings server/seed.ts",
    "make-env": "node scripts/make-env.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "shoot": "node scripts/shoot.mjs",
    "pretest": "npm run gen"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "astro": "^7.4.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
