---
/* The shell of every admin page and of the staff modules (/admin/..., /servitor/, /kuhnya/, /shofyor/): its own head
   (noindex, no canonical, no og, not in the sitemap), the font and the theme without a flash (as in Base.astro, but from
   "sa-prefs"), tokens.css + components.css + src/admin/admin.css. No client chrome of the site (header, footer, bottom
   nav, assistant, cookie banner): the frame is drawn by src/admin/a.ts (A.mount) after the session is known.

   About the hidden ".device" below: src/client/api.ts (needed by every admin page for the data) imports two small modules
   of the shared runtime chunk (lib/time.ts, lib/load.ts). Loading that chunk also runs src/client/sc.ts, which expects
   the elements of Base.astro and stops with an error without them. The empty, hidden elements let it start quietly
   (nothing of the site is shown, nothing is added to the shared runtime). The request to the chief is in the report. */
import "../styles/tokens.css";
import "../styles/components.css";
import "../admin/admin.css";
import "../lib/icons-all.ts"; /* server only: icons in the HTML */
import latinFont from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import cyrFont from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";

export interface Props {
  /** "<title>X | Siracusa · Админ</title>" (the page script can change it) */
  title: string;
  /** data-page on <html> */
  page: string;
  /** the waiting screen until the session is read (the admin frame): true; a page that draws itself (sign-in): false */
  boot?: boolean;
}
const p = Astro.props;
const demo = typeof __DEMO__ !== "undefined" && __DEMO__;
const path = Astro.url.pathname;
const depth = path.replace(/^\/|\/?index\.html$/g, "").split("/").filter(Boolean).length;
const root = depth ? "../".repeat(depth) : "./";
const fontCss = `@font-face{font-family:"Manrope";font-style:normal;font-display:swap;font-weight:200 800;src:url(${cyrFont}) format("woff2-variations"),url(${cyrFont}) format("woff2");unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}` +
  `@font-face{font-family:"Manrope";font-style:normal;font-display:swap;font-weight:200 800;src:url(${latinFont}) format("woff2-variations"),url(${latinFont}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
/* the theme of this device before the first paint (no flash); the same key as the prototype of the admin */
const boot = `(function(){var d=document.documentElement;try{var p=JSON.parse(localStorage.getItem("sa-prefs")||"{}");if(p.theme==="light"||p.theme==="dark")d.dataset.theme=p.theme;}catch(e){}})();`;
---
<!doctype html>
<html lang="bg" data-root={root} data-demo={demo ? "1" : undefined} data-page={p.page} data-admin="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{p.title} | Siracusa · Админ</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#F2F2EF" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href={cyrFont} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin>
<style is:inline set:html={fontCss}></style>
<script is:inline set:html={boot}></script>
</head>
<body>
<a class="vh skip" href="#main">Към съдържанието</a>
<div class="device" style="display:none" aria-hidden="true"><div data-scroller><div data-main></div></div></div><div data-ov style="display:none" aria-hidden="true"></div>
{p.boot !== false && <div class="sa-boot"><span class="vh" role="status">Зареждаме …</span></div>}
<slot />
</body>
</html>
