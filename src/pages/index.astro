<script>
  import { SC } from "../client/sc.ts";
  import { lunchTileText, goHTML, etaInner, eventsHTML, deliveryNote, dotHTML, firstOfferKey, greekLead, checkAddress } from "./_home.ts";
  /* the icons this script draws itself (the server ones are already in the HTML) */
  import "../lib/icons/pause.ts";
  import "../lib/icons/play.ts";
  import "../lib/icons/arrow-right.ts";
  import "../lib/icons/moped.ts";
  import "../lib/icons/warning-circle.ts";
  import "../lib/icons/check-circle.ts";
  import "../lib/icons/map-pin.ts";
  import "../lib/icons/storefront.ts";
  import "../lib/icons/calendar-check.ts";
  import "../lib/icons/calendar-blank.ts";
  import "../lib/icons/hourglass.ts";
  import "../lib/icons/confetti.ts";
  import "../lib/icons/seal-percent.ts";

  const main = SC.mount();
  const home = main.querySelector<HTMLElement>("[data-home]")!;
  const ic = SC.ic, $ = <T extends HTMLElement = HTMLElement>(s: string) => home.querySelector<T>(s)!;
  /* preview-only states (?preview=1#loading / #error / #offline), never on the real site */
  const demo = SC.preview ? (location.hash || "").slice(1) : "";

  /* the lunch menu in the data is for one date; never call it "today" on another day (BRIEF 8) */
  function sofiaDate(d = new Date()): string {
    try { return new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Sofia" }).format(d); } catch { return d.toISOString().slice(0, 10); }
  }
  const lunchToday = () => sofiaDate() === home.dataset.lunchDate;

  /* ---------- the parts that depend on the hour (redrawn now and every minute on sc:tick) ---------- */
  let lastKey = "";
  function timeParts() {
    const st = SC.state(), eta = SC.eta(), lt = lunchToday();
    const key = JSON.stringify([st, eta.text, lt, new Date().toDateString()]);
    if (key === lastKey) return;
    lastKey = key;
    const go = $("[data-go]");
    go.outerHTML = goHTML(st);
    $("[data-go]").addEventListener("click", (e) => { if ((e.currentTarget as HTMLElement).hasAttribute("data-pickup")) SC.cart.mode("pickup"); });
    $("[data-lunchtile]").innerHTML = lunchTileText(st, lt || SC.preview); /* like the offers banner: -30% only on a day with a lunch menu */
    $("[data-eta]").innerHTML = etaInner(st, eta);
    const dn = $("[data-dnote]"), note = deliveryNote(st);
    dn.innerHTML = note; dn.hidden = !note;
    if (demo !== "loading") { $("[data-evs]").innerHTML = eventsHTML(SC.events(), SC.lastSaturday().days); SC.reveal(); }
    promoSetup(st, lt);
  }

  /* ---------- hero: pull the clip under the floating header ---------- */
  function pull() { main.style.setProperty("--pull", main.offsetTop + "px"); }
  pull(); window.addEventListener("resize", pull);

  /* the clip starts after the first paint; pause button; rests while off screen */
  const film = $("[data-film]"), vbtn = $<HTMLButtonElement>("[data-vid]");
  vbtn.addEventListener("click", () => {
    const p = film.classList.toggle("paused"); vbtn.setAttribute("aria-pressed", String(p));
    vbtn.innerHTML = p ? ic("play", 20) + "<span>Пусни</span>" : ic("pause", 20) + "<span>Пауза</span>";
  });
  if (SC.reduce) { film.classList.add("paused"); vbtn.hidden = true; }
  if ("IntersectionObserver" in window) new IntersectionObserver((es) => film.classList.toggle("offscreen", !es[0].isIntersecting), { root: null }).observe(film);
  const start = () => requestAnimationFrame(() => requestAnimationFrame(() => { film.classList.add("live"); promoEl.classList.add("live"); }));
  if (document.readyState === "complete") start(); else window.addEventListener("load", start, { once: true });

  /* ---------- promo carousel (6 s, pause, dots, swipe; the first slide never animates in) ---------- */
  const promoEl = $("[data-promo]"), slidesBox = $("[data-slides]"), dotsBox = $("[data-dots]"), ppb = $<HTMLButtonElement>("[data-pp]");
  const variants = $<HTMLTemplateElement>("template[data-variants]").content;
  const DUR = 6000;
  let slides: HTMLElement[] = [], dots: HTMLButtonElement[] = [], cur = 0, timer: ReturnType<typeof setTimeout> | undefined, started = 0, left = DUR;
  let playing = !SC.reduce, userPaused = false;
  function promoSetup(st: ReturnType<typeof SC.state>, lt: boolean) {
    const fk = firstOfferKey(st, lt || SC.preview); /* preview and the demo count the menu as today, like the other pages */
    const first = variants.querySelector<HTMLElement>('[data-key="' + fk + '"]')!.cloneNode(true) as HTMLElement;
    first.removeAttribute("data-key");
    const rest = Array.from(slidesBox.querySelectorAll<HTMLElement>(".slide")).filter((s) => !/^(lunch|lunch30|tomorrow)$/.test(s.dataset.oid || ""));
    const list = [first, ...rest];
    if (st.lunch && list.length > 1) list.push(list.shift()!); /* the lunch tile is right above */
    /* Greek night: "След N дни" from today's date */
    list.forEach((s) => { if (s.dataset.oid === "greek") { const p = s.querySelector("[data-op]")!, t = p.textContent || ""; p.textContent = greekLead(SC.lastSaturday().days) + t.slice(t.indexOf(".")); } });
    slidesBox.replaceChildren(...list);
    slides = list; cur = 0;
    slides.forEach((s, i) => {
      s.classList.toggle("on", i === 0); s.setAttribute("aria-label", i + 1 + " от " + slides.length);
      if (i) s.setAttribute("aria-hidden", "true"); else s.removeAttribute("aria-hidden");
      const a = s.querySelector("a")!; if (i) a.tabIndex = -1; else a.removeAttribute("tabindex");
    });
    dotsBox.innerHTML = slides.map((s, i) => dotHTML(s.querySelector("h2")!.textContent || "", i)).join("");
    dots = Array.from(dotsBox.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    dots[0].setAttribute("aria-current", "true");
    dots.forEach((d) => d.addEventListener("click", () => { if (playing) setPlay(false, true); show(+d.dataset.dot!); }));
    $("[data-promo] .pctl").hidden = slides.length < 2;
    left = DUR;
    setPlay(!SC.reduce && !userPaused && slides.length > 1);
  }
  function show(i: number) {
    i = (i + slides.length) % slides.length; if (i === cur) return;
    const o = slides[cur], n = slides[i];
    o.classList.remove("on"); o.setAttribute("aria-hidden", "true"); o.querySelector("a")!.tabIndex = -1; dots[cur].removeAttribute("aria-current");
    cur = i; n.classList.add("on"); n.removeAttribute("aria-hidden"); n.querySelector("a")!.removeAttribute("tabindex"); dots[i].setAttribute("aria-current", "true");
    left = DUR; if (playing) arm();
  }
  function arm() { clearTimeout(timer); started = Date.now(); timer = setTimeout(() => show(cur + 1), left); }
  function setPlay(p: boolean, byUser = false) {
    if (byUser) userPaused = !p;
    playing = p; promoEl.classList.toggle("paused", !p); slidesBox.setAttribute("aria-live", p ? "off" : "polite");
    ppb.innerHTML = p ? ic("pause", 20) + "<span>Пауза</span>" : ic("play", 20) + "<span>Пусни</span>";
    if (p) arm(); else { clearTimeout(timer); left = Math.max(400, left - (Date.now() - started)); }
  }
  if (SC.reduce) promoEl.classList.add("stopped");
  ppb.addEventListener("click", () => { promoEl.classList.remove("stopped"); setPlay(!playing, true); });
  let sx: number | null = null;
  promoEl.addEventListener("pointerdown", (e) => { sx = e.clientX; if (playing && !(e.target as Element).closest("[data-pp]")) setPlay(false, true); });
  promoEl.addEventListener("pointerup", (e) => { if (sx === null) return; const dx = e.clientX - sx; sx = null; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); });
  promoEl.addEventListener("focusin", (e) => { if (playing && !(e.target as Element).closest("[data-pp]")) setPlay(false, true); });

  timeParts();
  document.addEventListener("sc:tick", timeParts);

  /* ---------- Bertha: the scale fills when it comes into view ---------- */
  const temp = $("[data-temp]");
  if (SC.reduce || !("IntersectionObserver" in window)) temp.classList.add("in");
  else { const tio = new IntersectionObserver((es) => { if (es[0].isIntersecting) { temp.classList.add("in"); tio.disconnect(); } }, { root: null, threshold: .5 }); tio.observe(temp); }

  /* ---------- address check ---------- */
  const chk = $<HTMLFormElement>("[data-chk]"), inp = chk.querySelector<HTMLInputElement>("#addr")!, err = chk.querySelector<HTMLElement>("#addr-err")!, res = chk.querySelector<HTMLElement>("[data-res]")!;
  inp.addEventListener("input", () => { if (!err.hidden) { err.hidden = true; inp.removeAttribute("aria-invalid"); } });
  chk.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = inp.value.trim();
    if (v.length < 3) { err.textContent = "Напишете квартал, улица или блок, например „Дружба 1, бл. 12“."; err.hidden = false; inp.setAttribute("aria-invalid", "true"); res.hidden = true; inp.focus(); return; }
    const r = checkAddress(v, SC.state(), SC.eta());
    res.className = "res " + r.c; res.innerHTML = r.html; res.hidden = false;
  });

  /* ---------- map: interactive Google Maps only after a tap ---------- */
  const map = $("[data-map]"), mapBtn = $<HTMLButtonElement>("[data-maplive]");
  mapBtn.addEventListener("click", () => {
    const f = document.createElement("iframe");
    f.src = map.dataset.embed!; f.title = "Карта: " + SC.RESTAURANT.address; f.loading = "lazy"; f.referrerPolicy = "no-referrer-when-downgrade"; f.setAttribute("allowfullscreen", "");
    map.querySelectorAll(":scope > svg, .pinw, .mtag").forEach((x) => x.remove());
    mapBtn.remove(); map.appendChild(f);
  });
  $("[data-vslot]").addEventListener("click", () => SC.toast("Видеото идва след новата фотосесия."));

  /* ---------- offline / retry ---------- */
  const offline = $("[data-offline]");
  function net() { offline.hidden = !(demo === "offline" || navigator.onLine === false); }
  net();
  home.addEventListener("click", (e) => { if ((e.target as Element).closest("[data-retry]")) { location.hash = ""; location.reload(); } });
  window.addEventListener("offline", () => { net(); SC.toast("Няма връзка. Менюто остава, поръчката ще изпратите по-късно."); });
  window.addEventListener("online", () => { net(); SC.toast("Връзката се върна."); });

  /* ---------- preview only: simulated states + the "Само в прототипа" panel ---------- */
  if (SC.preview) {
    if (demo === "loading") {
      $("[data-popbody]").innerHTML = '<div class="rail pop" aria-busy="true" aria-label="Зареждане">' + [0, 1, 2, 3].map(() => '<div class="skcard"><div class="skel a"></div><div class="skel b"></div><div class="skel c"></div></div>').join("") + "</div>";
      $("[data-evs]").innerHTML = '<div class="card ev" aria-busy="true"><div class="skel" style="height:96px"></div><div class="stack"><div class="skel" style="height:22px;width:70%"></div><div class="skel" style="height:18px;width:50%"></div><div class="skel" style="height:48px;width:60%;border-radius:999px"></div></div></div>';
    } else if (demo === "error") {
      $("[data-popbody]").innerHTML = '<div class="errbox" role="alert">' + ic("warning-circle", 28) + "<b>Не успяхме да заредим ястията.</b><p>Проверете връзката и опитайте пак. Можете да поръчате и по телефона: " + SC.RESTAURANT.phone + '.</p><button class="pill pill-line" type="button" data-retry>Опитай пак</button></div>';
    }
    const states: [string, string][] = [["", "Нормално"], ["loading", "Зареждане"], ["error", "Грешка"], ["offline", "Без интернет"]];
    home.insertAdjacentHTML("beforeend", '<section class="sec" aria-label="Само в прототипа"><div class="proto"><b>Само в прототипа</b><div class="chips" style="margin:8px 0 0;padding:2px 0;flex-wrap:wrap">' +
      states.map((x) => '<a class="chip" href="#' + x[0] + '" data-demo="' + x[0] + '"' + (demo === x[0] ? ' aria-current="true"' : "") + ">" + x[1] + "</a>").join("") + "</div></div></section>");
    home.querySelectorAll<HTMLAnchorElement>("[data-demo]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); location.hash = a.dataset.demo!; location.reload(); }));
  }

  SC.reveal();
</script>
