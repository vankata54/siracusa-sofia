---
/* Home (design/pages/home.html, design/PAGES.md "home.html"). Everything that does not depend on the hour is drawn here
   (SEO, fast first paint). The parts that depend on the hour, the date or the visitor (Поръчай, обедно меню, доставка сега,
   оферти, събития, бележката за доставка) are drawn here for the build moment and redrawn in the browser from _home.ts. */
import Base from "../layouts/Base.astro";
import { url, ic, art, dishCard, byId, isOut, inCat, lunchIsToday, offers, events, state, eta, lastSaturday, ZONES, RESTAURANT } from "../lib/index.ts";
import { MENU } from "../data/menu.ts";
import { goHTML, lunchTileText, etaInner, slideHTML, dotHTML, firstOfferKey, eventsHTML, deliveryNote, restaurantLd } from "./_home.ts";

const R = RESTAURANT, MENU_LUNCH_DATE = MENU.lunch.date;
const st = state(), et = eta(), lunchToday = lunchIsToday(), ls = lastSaturday();

/* ---------- offers: the first slide has 4 variants by the hour; the browser picks one ---------- */
const lunchDay = new Date(MENU_LUNCH_DATE + "T12:00:00");
const otherDay = new Date(lunchDay.getTime() + 864e5);
const variants: Record<string, ReturnType<typeof offers>[number]> = {
  lunchToday: offers("11:00", lunchDay)[0],
  lunch: offers("11:00", otherDay)[0],
  lunch30: offers("16:00", lunchDay)[0], /* the -30% slide exists only on a day with a lunch menu */
  tomorrow: offers("23:30")[0],
};
const rest = offers().slice(1);
const fk = firstOfferKey(st, lunchToday);
let slides: [ReturnType<typeof offers>[number], string][] = [[variants[fk], fk], ...rest.map((o) => [o, o.id] as [typeof o, string])];
if (st.lunch && slides.length > 1) slides.push(slides.shift()!); /* the lunch tile is right above: say something new first */
const slidesHTML = slides.map(([o, k], i) => slideHTML(o, k).replace('class="slide"', 'class="slide' + (i === 0 ? " on" : "") + '"' + (i ? ' aria-hidden="true"' : "") + ' aria-label="' + (i + 1) + " от " + slides.length + '"').replace(/<a class="pill"/, i ? '<a class="pill" tabindex="-1"' : '<a class="pill"')).join("");
const dotsHTML = slides.map(([o], i) => dotHTML(o.t, i).replace("<button ", i === 0 ? '<button aria-current="true" ' : "<button ")).join("");
const variantsHTML = Object.entries(variants).map(([k, o]) => slideHTML(o, k).replace('class="slide"', 'class="slide" data-key="' + k + '"')).join("");

/* ---------- popular ([ЛИПСВА]: real best sellers from the till) ---------- */
const POP = ["pitsa-s-burata-i-proshuto-krudo", "svinski-rebra", "pitsa-s-proshuto-koto-i-tryufel", "pitsa-margarita", "kebapcheta", "pitsa-dyavolo", "ribay-stek-ot-blek-angas", "pitsa-vegetariana"];
const popItems = POP.map((id) => byId[id]).filter((x) => x && !isOut(x));
const berthaN = inCat("skara-bertha").length;

/* ---------- hero film: sparks ---------- */
const sparks = [[58, "5px", "4.8s", "0s", "-22px", "34%"], [66, "4px", "5.6s", "1.1s", "10px", "30%"], [74, "6px", "4.2s", "2.2s", "-30px", "38%"], [82, "4px", "6s", "0.6s", "14px", "32%"],
  [62, "3px", "5.2s", "3s", "-8px", "40%"], [88, "5px", "4.6s", "1.8s", "-20px", "36%"], [70, "3px", "6.4s", "3.8s", "18px", "28%"], [78, "4px", "5s", "4.4s", "-14px", "42%"]]
  .map((p) => '<span class="spark" style="--x:' + p[0] + "%;--s:" + p[1] + ";--d:" + p[2] + ";--w:" + p[3] + ";--dx:" + p[4] + ";--b:" + p[5] + '"></span>').join("");

const free = ZONES.filter((z) => z.free), paid = ZONES.filter((z) => !z.free);
const dnote = deliveryNote(st);

const mapSvg = '<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">' +
  '<path class="park" d="M-10 214 C40 196 96 206 130 236 L150 310 L-10 310Z"/>' +
  '<rect class="blk" x="22" y="26" width="92" height="58" rx="10"/><rect class="blk" x="22" y="108" width="62" height="72" rx="10"/><rect class="blk" x="150" y="20" width="70" height="44" rx="10"/>' +
  '<rect class="blk" x="250" y="18" width="128" height="50" rx="10"/><rect class="blk" x="270" y="96" width="44" height="88" rx="10"/><rect class="blk" x="334" y="96" width="60" height="64" rx="10"/>' +
  '<rect class="blk" x="164" y="196" width="80" height="60" rx="10"/><rect class="blk" x="276" y="214" width="108" height="64" rx="10"/><rect class="blk" x="112" y="112" width="30" height="64" rx="8"/>' +
  '<path class="road big" d="M-20 94 C120 92 240 84 420 82"/><path class="road mid" d="M236 -10 C232 80 246 170 258 320"/><path class="road sm" d="M-10 192 C70 188 160 186 250 190"/>' +
  '<path class="road sm" d="M132 -10 L138 92"/><path class="road sm" d="M256 196 C310 200 360 196 420 190"/><path class="road sm" d="M98 96 L104 300"/></svg>';
/* Google Maps embed, loaded only after a tap (no third-party request before that) */
const mapEmbed = "https://www.google.com/maps?output=embed&hl=bg&q=" + encodeURIComponent(R.name + ", " + R.address);

const jsonld = restaurantLd(Astro.site);
---
<Base page="home" nav={null} title="Начало" docTitle="Пица на пещ и скара в Дружба 2"
  description="Siracusa Bar & Grill в ж.к. Дружба 2, София: пица на пещ, скара на дървени въглища във фурна Bertha, обедно меню с доставка. Всеки ден 10:00 - 23:00, доставка до 21:00."
  jsonld={jsonld}>
  <div class="homepg" data-home data-lunch-date={MENU_LUNCH_DATE}>
  <!-- ---------- hero: simulated 8 - 15 s clip ([ЛИПСВА: видео]) under the floating header ---------- -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="stage">
      <div class="film" data-film aria-hidden="true"><div class="cam"><span class="glow"></span><span class="shade"></span><span class="spin" set:html={art("pitsa-dyavolo")}></span><Fragment set:html={sparks} /></div><span class="veil"></span></div>
      <div class="htxt"><p class="eyebrow" hidden>Siracusa Bar &amp; Grill</p><h1 class="h1" id="hero-h">Пица на пещ и скара на дървени въглища</h1><p>В Дружба 2. Всеки ден до 23:00.</p></div>
      <div class="vctl"><button class="vbtn" type="button" data-vid aria-pressed="false"><Fragment set:html={ic("pause", 20)} /><span>Пауза</span></button><span class="vtag">[ЛИПСВА: видео 8 - 15 сек.]</span></div>
    </div>
    <div class="acts">
      <div class="offline" role="status" data-offline hidden><Fragment set:html={ic("warning", 22)} /><div><b>Няма връзка с интернет</b><p>Менюто се вижда. Поръчката ще изпратите, щом връзката се върне.</p><button class="link" type="button" data-retry>Опитай пак<Fragment set:html={ic("caret-right", 18)} /></button></div></div>
      <Fragment set:html={goHTML(st)} />
      <div class="tiles">
        <a class="tile" href={url.reservation()}><span class="ti" set:html={ic("calendar-check", 22)}></span><span><b>Резервирай маса</b><small>Салон и градина</small></span></a>
        <a class="tile" href={url.lunch()}><span class="ti" set:html={ic("bowl-food", 22)}></span><span data-lunchtile set:html={lunchTileText(st, lunchToday)}></span></a>
      </div>
      <a class="eta" href={url.page("delivery")} data-eta set:html={etaInner(st, et)}></a>
    </div>
  </section>

  <!-- ---------- promo banner (ember): offers(), 6 s, pause, dots; the first slide is static ---------- -->
  <section class="sec promo-sec" aria-label="Оферти">
    <div class="promo" data-promo role="region" aria-roledescription="въртящ се банер" aria-label="Оферти">
      <div class="slides" data-slides aria-live="off" set:html={slidesHTML}></div>
      <div class="pctl"><div class="dots" role="group" aria-label="Избери оферта" data-dots set:html={dotsHTML}></div>
        <button class="pp" type="button" data-pp><Fragment set:html={ic("pause", 20)} /><span>Пауза</span></button></div>
    </div>
    <template data-variants set:html={variantsHTML}></template>
  </section>

  <!-- ---------- popular ---------- -->
  <section class="sec" aria-labelledby="pop-h">
    <div class="sec-h"><h2 class="h2" id="pop-h">Популярни</h2><a class="link" href={url.menu()}>Цялото меню<Fragment set:html={ic("caret-right", 18)} /></a></div>
    <p class="small sec-note"><span class="missing">[ЛИПСВА: най-поръчваните по данни от касата; сега примерен избор]</span></p>
    <div data-popbody>
      {popItems.length
        ? <div class="rail pop" set:html={popItems.map((x) => dishCard(x)).join("")}></div>
        : <div class="errbox" role="alert"><Fragment set:html={ic("warning-circle", 28)} /><b>Не успяхме да заредим ястията.</b><p>Проверете връзката и опитайте пак. Можете да поръчате и по телефона: {R.phone}.</p><button class="pill pill-line" type="button" data-retry>Опитай пак</button></div>}
    </div>
  </section>

  <!-- ---------- Bertha ---------- -->
  <section class="sec" aria-labelledby="bertha-h"><div class="shell rv"><div class="core bcore">
    <div class="btxt"><p class="eyebrow">Нашата фурна</p><h2 class="h2" id="bertha-h">Фурната Bertha</h2>
      <p class="lead">Затворена фурна на дървени въглища. Огънят нагрява стените и тавана, затова месото се пече равномерно и хваща опушен вкус.</p>
      <ul class="facts" style="margin-top:20px"><li><Fragment set:html={ic("fire", 22)} /><span>Истински дървени въглища</span></li><li><Fragment set:html={ic("thermometer", 22)} /><span>Равномерна топлина отвсякъде</span></li><li><Fragment set:html={ic("fork-knife", 22)} /><span>{berthaN} ястия от скарата в менюто</span></li></ul></div>
    <div class="temp" data-temp><div class="deg" role="img" aria-label="до 350 градуса">350<small>°C</small></div><p class="deg-cap">Толкова става в затворената камера. Работим между 250 и 350 °C.</p>
      <div class="scale" aria-hidden="true"><span class="band"></span><span class="mk"></span></div><div class="scale-l" aria-hidden="true"><span style="left:0">0</span><span class="on" style="left:62.5%">250</span><span class="on" style="left:87.5%">350</span></div></div>
    <div class="bact"><a class="pill pill-light" href={url.cat("skara-bertha")}>Ястията от Bertha<Fragment set:html={ic("arrow-right", 20)} /></a><a class="pill pill-ghost" href={url.page("bertha")}>Как работи фурната</a></div>
  </div></div></section>

  <!-- ---------- come visit (long video slot) ---------- -->
  <section class="sec visit" aria-labelledby="visit-h">
    <div class="vid shell rv"><div class="core vslot"><button class="play" type="button" data-vslot aria-label="Пусни видеото за ресторанта"><Fragment set:html={ic("play", 32)} /></button>
      <b>Видео за ресторанта</b><span class="missing">[ЛИПСВА: видео 30 - 45 сек. от новата фотосесия: отвън, салон, градина, фурната, ястията]</span>
      <span class="len"><Fragment set:html={ic("video-camera", 18)} />без звук</span></div></div>
    <div class="vtxt"><div class="sec-h" style="margin:22px 0 8px"><h2 class="h2" id="visit-h">Елате при нас</h2></div>
      <p class="lead">Салон и отоплявана градина, която работи целогодишно. Подходящо за вечеря с приятели и за семейни празници.</p>
      <ul class="places"><li><Fragment set:html={ic("chair", 22)} />Салон</li><li><Fragment set:html={ic("tree", 22)} />Отоплявана градина</li></ul>
      <a class="pill pill-red pill-lg pill-block" href={url.reservation()}><Fragment set:html={ic("calendar-check", 22)} />Резервирай маса</a></div>
  </section>

  <!-- ---------- events ---------- -->
  <section class="sec" aria-labelledby="ev-h">
    <div class="sec-h"><h2 class="h2" id="ev-h">Предстоящи събития</h2><a class="link" href={url.events()}>Всички<Fragment set:html={ic("caret-right", 18)} /></a></div>
    <div class="evs" data-evs set:html={eventsHTML(events(), ls.days)}></div>
  </section>

  <!-- ---------- office lunch ---------- -->
  <section class="sec" aria-labelledby="off-h"><div class="card office rv">
    <div><div class="oh"><span class="oi" set:html={ic("briefcase", 24)}></span><h2 class="h3" id="off-h">Обща поръчка за офиса</h2></div><p style="margin-top:10px">Една обща поръчка за целия офис, с една доставка до 15:00.</p></div>
    <ol class="steps"><li>Създавате обща връзка</li><li>Всеки колега избира сам</li><li>Доставяме всичко заедно</li></ol>
    <a class="pill pill-line" href={url.page("office")}>Започни обща поръчка<Fragment set:html={ic("arrow-right", 20)} /></a>
  </div></section>

  <!-- ---------- delivery zones + address check ---------- -->
  <section class="sec" id="dostavka" aria-labelledby="dl-h">
    <div class="sec-h"><h2 class="h2" id="dl-h">Доставка до 21:00</h2></div>
    <p class="dnote" data-dnote hidden={!dnote} set:html={dnote}></p>
    <div class="dlv"><div>
      <div class="zgroup"><h3>Безплатна доставка</h3><ul class="ztags">{free.map((z) => <li><Fragment set:html={ic("check-circle", 20)} />{z.n}</li>)}</ul></div>
      <div class="zgroup"><h3>По тарифа</h3><ul class="ztags paid">{paid.map((z) => <li><Fragment set:html={ic("map-pin", 20)} />{z.n}</li>)}</ul><span class="missing">[ЛИПСВА: такси за доставка в €]</span></div>
      <a class="link" href={url.page("delivery")}>Карта на зоните<Fragment set:html={ic("caret-right", 18)} /></a>
      <p class="pay"><Fragment set:html={ic("wallet", 20)} /><span>Плащане на място: В брой, Карта при получаване или Ваучер.</span></p>
    </div>
    <form class="card chk rv" data-chk novalidate action={url.page("delivery")}><div class="field"><label for="addr">Провери адреса си</label>
      <div class="irow"><input class="input" id="addr" name="addr" type="text" autocomplete="street-address" placeholder="Квартал и блок" aria-describedby="addr-err"><button class="pill pill-red" type="submit">Провери</button></div>
      <p class="err" id="addr-err" hidden></p></div>
      <div class="res" data-res hidden aria-live="polite"></div></form></div>
  </section>

  <!-- ---------- how to get here (static schematic, live map on tap) ---------- -->
  <section class="sec" aria-labelledby="wh-h">
    <div class="sec-h"><h2 class="h2" id="wh-h">Как да стигнете</h2></div>
    <div class="where">
      <div class="shell rv"><div class="core map" data-map data-embed={mapEmbed}><Fragment set:html={mapSvg} />
        <div class="pinw" aria-hidden="true"><span class="lbl">Siracusa</span><span class="pin" set:html={ic("fork-knife", 22)}></span><span class="ring"></span></div>
        <span class="mtag missing">[ЛИПСВА: статична карта от Google]</span>
        <button class="pill live" type="button" data-maplive><Fragment set:html={ic("map-trifold", 20)} />Отвори картата</button></div></div>
      <div class="info"><p class="addr"><Fragment set:html={ic("map-pin", 24)} /><span>{R.address}</span></p>
        <div class="kv"><span>Всеки ден</span><b>{R.open} - {R.close}</b></div><div class="kv"><span>Кухнята приема</span><b>до {R.kitchen}</b></div>
        <div class="kv"><span>Доставка</span><b>до {R.delivery}</b></div><div class="kv"><span>Обедно меню</span><b>{R.open} - {R.lunchUntil}</b></div>
        <div class="kv"><span>Паркиране</span><b class="missing">[ЛИПСВА]</b></div>
        <div class="btns"><a class="pill pill-ink pill-lg" href={R.maps} target="_blank" rel="noopener"><Fragment set:html={ic("path", 22)} />Маршрут в Google Maps</a>
          <a class="pill pill-line pill-lg" href={"tel:" + R.phoneIntl}><Fragment set:html={ic("phone", 22)} />{R.phone}</a></div></div>
    </div>
  </section>
  </div>
</Base>

<style is:global>
/* Home page only. Tokens from styles/tokens.css; translucency via color-mix() of tokens, no new colours. */
.homepg .eyebrow{margin:0 0 10px; font-size:14px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; color:var(--muted)}

/* ---------- hero ---------- */
.hero{display:grid; grid-template-columns:minmax(0,1fr); grid-template-areas:"stage" "acts"}
.stage{grid-area:stage; position:relative; isolation:isolate; overflow:hidden; display:flex; flex-direction:column; justify-content:flex-end;
  margin-top:calc(var(--pull,120px) * -1); min-height:calc(var(--pull,120px) + 300px); padding:calc(var(--pull,120px) + 24px) 20px 24px;
  border-radius:0 0 36px 36px; color:var(--on-chip-dark)}
.film{position:absolute; inset:0; z-index:-1; overflow:hidden; background:var(--chip-dark); border-radius:inherit}
.film .cam{position:absolute; inset:0; animation:hm-cam 16s var(--ease-std) infinite alternate; transform-origin:70% 35%}
.film .glow{position:absolute; width:520px; height:520px; right:-170px; top:calc(var(--pull,120px) - 150px); border-radius:50%;
  background:radial-gradient(closest-side, color-mix(in srgb, var(--ember) 62%, transparent), color-mix(in srgb, var(--ember) 18%, transparent) 55%, transparent);
  animation:hm-flicker 3.4s ease-in-out infinite alternate}
.film .spin{position:absolute; width:370px; height:370px; right:-96px; top:calc(var(--pull,120px) - 74px); animation:hm-spin 60s linear infinite}
.film .spin svg{width:100%; height:100%; display:block}
.film .shade{position:absolute; width:340px; height:340px; right:-78px; top:calc(var(--pull,120px) - 40px); border-radius:50%; background:radial-gradient(closest-side, color-mix(in srgb, var(--chip-dark) 70%, transparent), transparent)}
.film .spark{position:absolute; left:var(--x); bottom:var(--b,40%); width:var(--s,5px); height:var(--s,5px); border-radius:50%; background:var(--ember); opacity:0;
  animation:hm-rise var(--d,4.6s) linear var(--w,0s) infinite}
.film .veil{position:absolute; inset:0; background:linear-gradient(to top, var(--chip-dark) 18%, color-mix(in srgb, var(--chip-dark) 72%, transparent) 46%, transparent 74%)}
/* the clip starts only after the first paint (.live from the script): nothing moves before LCP */
.film:not(.live) *, .film.paused *, .film.offscreen *{animation-play-state:paused}
@keyframes hm-spin{to{transform:rotate(360deg)}}
@keyframes hm-cam{from{transform:scale(1)}to{transform:scale(1.07)}}
@keyframes hm-flicker{0%{opacity:.7; transform:scale(.97)}45%{opacity:1; transform:scale(1.02)}70%{opacity:.82; transform:scale(.99)}100%{opacity:.96; transform:scale(1.04)}}
@keyframes hm-rise{0%{opacity:0; transform:translate(0,0) scale(1)}12%{opacity:.95}70%{opacity:.5}100%{opacity:0; transform:translate(var(--dx,-18px),-230px) scale(.4)}}
.htxt{position:relative; z-index:1}
.htxt .h1{font-size:40px; line-height:1.02; letter-spacing:-.05em; color:var(--on-chip-dark); max-width:12ch}
.htxt p{margin:12px 0 0; font-size:18px; font-weight:600; color:color-mix(in srgb, var(--on-chip-dark) 80%, transparent)}
.vctl{position:relative; z-index:2; display:flex; align-items:center; gap:12px; margin-top:22px}
.vbtn{display:inline-flex; align-items:center; gap:8px; min-height:48px; padding:0 18px 0 14px; border:0; border-radius:999px; cursor:pointer; font-weight:700; font-size:16px;
  color:var(--on-chip-dark); background:color-mix(in srgb, var(--on-chip-dark) 14%, transparent); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
  box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--on-chip-dark) 18%, transparent); transition:transform var(--t-fast) var(--ease)}
.vbtn:active{transform:scale(.96)}
.vtag{font-size:14px; line-height:1.3; color:color-mix(in srgb, var(--on-chip-dark) 62%, transparent); font-style:italic; text-decoration:underline dashed 1px; text-underline-offset:4px}

/* hero actions */
.acts{grid-area:acts; min-width:0; display:grid; grid-template-columns:minmax(0,1fr); gap:10px; padding:16px 16px 0}
.go .gol{display:grid; min-width:0; text-align:left; line-height:1.15; white-space:normal}
.go .gol small{font-size:14px; font-weight:600; opacity:.86; margin-top:3px}
.tiles{display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:10px}
.tile{position:relative; display:grid; align-content:start; gap:10px; min-height:104px; padding:12px 12px 14px 14px; border-radius:var(--r-core); background:var(--surface); box-shadow:var(--hi), var(--shadow);
  text-decoration:none; color:var(--ink); transition:transform var(--t-fast) var(--ease)}
.tile:active{transform:scale(.97)}
.tile .ti{width:40px; height:40px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2); color:var(--red)}
.tile b{display:block; font-size:16px; line-height:1.2; letter-spacing:-.015em}
.tile small{display:block; margin-top:3px; font-size:14px; font-weight:600; color:var(--muted); line-height:1.3}
.tile small.hot{color:var(--ink)}
.tile small.hot span{display:inline-block; padding:1px 7px; margin-right:4px; border-radius:999px; background:var(--ember); color:var(--on-ember); font-weight:800}
.eta{display:flex; align-items:center; gap:12px; min-height:56px; padding:8px 14px 8px 18px; border-radius:999px; background:var(--surface-2); color:var(--ink); text-decoration:none; font-size:16px; line-height:1.3}
.eta .dot{width:10px; height:10px; border-radius:50%; flex:none; background:var(--off)}
.eta .dot.ok{background:var(--ok)} .eta .dot.warn{background:var(--warn)}
.eta .dot.ok{animation:hm-breathe 2.4s ease-in-out infinite}
@keyframes hm-breathe{0%,100%{transform:scale(1); opacity:1}50%{transform:scale(.7); opacity:.6}}
.eta .tx{flex:1; min-width:0; display:grid}
.eta .tx span{color:var(--muted); font-weight:600; font-size:15px}
.eta > .ic{color:var(--muted)}
