---
/* Dish (/menu/<кат>/<ястие>/): port of design/pages/dish.html (design/PAGES.md "dish.html", decisions 13, 15, 17).
   One static page per dish (SEO): the server draws everything that does not depend on the hour, the cart or the visitor
   (visual, H1, price, weight, composition, allergens, "Върви добре с" for an empty cart, sold out + 3 similar, buy box,
   JSON-LD MenuItem + BreadcrumbList). The browser adds: the "kitchen closed" note, "Върви добре с" for the current cart,
   "Любимо", the back link by referrer, the "Добавки и промени" sheet, the counter, 3D and adding to the cart. */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { ic, pic, badges, url, fmt, esc, isOut, type Dish } from "../../../lib/index.ts";
import { DISHES, ADDONS, catOf, canAdd, hasMods, modBtnInner, buyHTML, soldBarHTML, favHTML, similar, pairCard, pairsHTML, factsCard, metaDescription, dishLd, dishLite, docTitle } from "./_dish.ts";
import { catById } from "../../../lib/data.ts";

export const getStaticPaths = (() => DISHES.map((x) => ({ params: { kategoria: x.cat, yastie: x.id }, props: { id: x.id } }))) satisfies GetStaticPaths;

const x: Dish = DISHES.find((d) => d.id === Astro.props.id)!;
const cat = catOf(x);
const out = isOut(x);

const facts: string[] = [];
if (x.share) facts.push('<span class="badge">' + ic("users-three", 16) + "За споделяне</span>");
if (x.cat === "skara-bertha") facts.push('<span class="badge">' + ic("fire", 16) + "От фурната Bertha</span>");

const simHTML = out ? similar(x).map((z) => pairCard(z, catById[z.cat] ? catById[z.cat].n : "")).join("") : "";
const jsonld = dishLd(x, Astro.site);
/* what the page script needs, so the browser does not load the whole menu at start (speed) */
const lite = JSON.stringify({ x: dishLite(x), addons: canAdd(x) ? ADDONS : [] }).replace(/</g, "\\u003c");
---
<Base page="dish" nav="menu" back={{ href: cat.back, label: "Меню" }} title={x.n} docTitle={docTitle(x)} share actionBar
  description={metaDescription(x)} jsonld={jsonld}>
  <article class="dish" data-dish={x.id} data-cat={cat.id} data-catn={cat.n}>
    <script is:inline type="application/json" data-dishjson set:html={lite}></script>
    <div class="dgrid">
      <div class="hero">
        <div class="shell"><div class="core">
          <Fragment set:html={pic(x) + badges(x, true)} />
          {!out && <button class="v3d" type="button" data-3d><Fragment set:html={ic("cube", 20)} />Виж в 3D</button>}
          <span class="hint3d" aria-hidden="true"><Fragment set:html={ic("hand-waving", 18)} />Завъртете с пръст</span>
        </div></div>
        <p class="note3d muted" data-note3d hidden>Прототип: истинският 3D модел идва след фотосесията. <span class="missing">[ЛИПСВА: 3D модел]</span></p>
      </div>
      <div class="info">
        <nav aria-label="Хлебни трохи"><ol class="crumbs">
          <li><a href={url.menu()}>Меню</a></li>
          <li><Fragment set:html={ic("caret-right", 16)} /><a href={cat.href} data-catlink>{cat.n}</a></li>
        </ol></nav>
        <h1 class="h1" data-h1>{x.n}</h1>
        <div class="prow2">
          <span class="pg"><span class="price">{fmt(x.p)}</span>{x.per100 ? <span class="g">за 100 гр.</span> : x.g ? <span class="g">{x.g}</span> : null}</span>
          <Fragment set:html={favHTML(false)} />
        </div>
        {x.per100 && <p class="per100note">Продава се на тегло: сумата се смята по теглото на парчето. <span class="missing">[ЛИПСВА: среден грамаж на порция]</span></p>}
        {facts.length > 0 && <div class="badges facts" set:html={facts.join("")}></div>}
        <div data-closedslot></div>
        {out ? (
          <Fragment>
            <div class="soldout" role="status"><span class="ico" set:html={ic("clock", 24)}></span><span><b>Изчерпано днес</b><span>Вижте подобни ястия, които имаме сега.</span></span></div>
            <section class="subsec" id="similar" aria-labelledby="simh"><h2 class="h3" id="simh">Вижте подобни</h2><div class="pairs" set:html={simHTML}></div></section>
          </Fragment>
        ) : (
          <Fragment>
            {hasMods(x) && <button class="modbtn" type="button" data-mods aria-haspopup="dialog" set:html={modBtnInner(x, ADDONS)}></button>}
            <div class="buy" data-buybox set:html={buyHTML(x)}></div>
          </Fragment>
        )}
        <p class="desc"><span class="missing">[ЛИПСВА: описание на ястието - как се приготвя и с какво върви]</span></p>
        <Fragment set:html={factsCard(x)} />
      </div>
    </div>
  </article>
  <div data-pairs set:html={pairsHTML(x)}></div>
  <div class={"abar dish-abar" + (out ? " out" : "")} slot="ov" set:html={out ? soldBarHTML() : buyHTML(x)}></div>
</Base>

<style is:global>
/* ---------- dish page (page-only styles, tokens only); 1:1 from design/pages/dish.html ---------- */

/* header: the dish name fades into the back bar once the H1 scrolls away */
.top.back .ttl{opacity:0; transform:translateY(6px); transition:opacity var(--t-base) var(--ease), transform var(--t-base) var(--ease)}
.top.back .ttl.on{opacity:1; transform:none}

.dish{padding:12px 16px 0}
.dgrid{display:grid; grid-template-columns:minmax(0,1fr); gap:20px}

/* hero visual */
.dish .hero{position:relative}
.dish .hero .core{position:relative}
.dish .hero .pic{aspect-ratio:4/3; border-radius:var(--r-img); touch-action:pan-y}
.dish .hero .pic::before{content:""; position:absolute; inset:0; background:radial-gradient(60% 55% at 50% 52%, var(--ember-soft), transparent 70%); pointer-events:none}
.dish .hero .pic > svg{inset:4% 0; width:100%; height:92%; transform-origin:50% 50%; animation:arrive 900ms var(--ease) backwards}
@keyframes arrive{from{opacity:0; transform:rotate(-28deg) scale(.9)} to{opacity:1; transform:none}}
.dish .hero .badges.onpic{top:14px; right:14px}
.dish .hero .badges.onpic .badge{min-height:32px; padding:7px 12px 7px 10px}
.v3d{position:absolute; left:12px; bottom:12px; z-index:3; display:inline-flex; align-items:center; gap:8px; min-height:48px; padding:0 18px 0 14px; border:0; border-radius:var(--r-pill); background:var(--glass); color:var(--ink); -webkit-backdrop-filter:blur(16px); backdrop-filter:blur(16px); box-shadow:inset 0 0 0 1px var(--glass-line), var(--shadow); font-weight:700; font-size:16px; cursor:pointer; transition:transform var(--t-fast) var(--ease)}
.v3d:active{transform:scale(.96)}
.v3d[aria-busy="true"]{cursor:progress}
.v3d .spin{width:18px; height:18px; border-radius:50%; box-shadow:inset 0 0 0 2.5px var(--line-strong); border-top:2.5px solid var(--ink); animation:spin 800ms linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.dish .hero .pic.loading > svg{animation:breathe 900ms var(--ease) infinite alternate}
@keyframes breathe{from{opacity:1} to{opacity:.55}}
.dish .hero .pic.is3d{cursor:grab}
.dish .hero .pic.is3d:active{cursor:grabbing}
.dish .hero .pic.is3d > svg{animation:none}
.hint3d{position:absolute; right:14px; bottom:18px; z-index:3; transform:translateY(8px); opacity:0; display:inline-flex; align-items:center; gap:8px; min-height:36px; padding:0 14px; border-radius:var(--r-pill); background:var(--chip-dark); color:var(--on-chip-dark); font-size:14px; font-weight:700; pointer-events:none; transition:opacity var(--t-slow) var(--ease), transform var(--t-slow) var(--ease); white-space:nowrap}
.hint3d.on{opacity:1; transform:none}
.note3d{margin:10px 6px 2px; font-size:14px}

/* info column */
.crumbs{display:flex; flex-wrap:wrap; align-items:center; gap:2px; list-style:none; margin:0 0 2px; padding:0; font-size:15px; font-weight:700; color:var(--muted)}
.crumbs li{display:flex; align-items:center; gap:2px}
.crumbs a{min-height:48px; display:inline-flex; align-items:center; text-decoration:none; color:var(--muted); padding:0 2px}
.crumbs a:hover{color:var(--ink)}
.crumbs .ic{opacity:.6}
.dish .h1{font-size:36px}
.prow2{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:14px}
.prow2 .pg{display:flex; align-items:baseline; gap:12px; min-width:0}
.prow2 .price{font-size:30px; letter-spacing:-.03em}
.prow2 .g{font-size:17px; color:var(--muted); font-weight:600; white-space:nowrap}
.facts{margin-top:10px}
.fav{flex:none; min-height:48px; padding:0 18px 0 14px; font-size:16px}
.fav .ic{color:var(--muted); transition:transform var(--t-base) var(--ease)}
.fav[aria-pressed="true"]{background:var(--surface-2); box-shadow:none}
.fav[aria-pressed="true"] .ic{color:var(--red)}
.fav.pop .ic{animation:pop var(--t-spring) var(--ease)}
@keyframes pop{40%{transform:scale(1.3)}}
.u100{font-size:15px; font-weight:700; opacity:.85}
.per100note{margin:10px 0 0; font-size:15px; color:var(--muted)}
.dietlbl{margin:0 0 8px; font-size:14px; font-weight:700; color:var(--muted)}
.desc{margin:14px 0 0; font-size:16px}
.closednote{margin-top:14px; padding:12px 16px; border-radius:var(--r-field); background:var(--surface-2); color:var(--ink); font-size:15px; font-weight:600; display:flex; gap:10px; align-items:flex-start}
.closednote .ic{color:var(--warn); margin-top:1px}

/* "Добавки и промени" opener */
.modbtn{margin-top:18px; width:100%; display:grid; grid-template-columns:52px 1fr 20px; align-items:center; gap:14px; min-height:72px; padding:10px 20px 10px 10px; border:0; border-radius:var(--r-pill); background:var(--surface); color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--line-strong); text-align:left; cursor:pointer; transition:transform var(--t-fast) var(--ease)}
.modbtn:active{transform:scale(.985)}
.modbtn .ico{width:52px; height:52px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2)}
.modbtn b{display:block; font-size:17px; line-height:1.25}
.modbtn .xp{display:block; margin-top:2px; font-weight:800; font-size:15px; font-variant-numeric:tabular-nums; white-space:nowrap}
.modbtn .sub{font-size:14px; color:var(--muted); font-weight:600; line-height:1.35; margin-top:2px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical}
.modbtn.has .sub{color:var(--ink)}
.modbtn .end{display:grid; place-items:center; color:var(--muted)}

/* sold out notice */
.soldout{margin-top:18px; display:flex; gap:14px; align-items:center; padding:14px 18px 14px 14px; border-radius:var(--r-core); background:var(--surface); box-shadow:inset 0 0 0 1.5px var(--warn)}
.soldout .ico{width:48px; height:48px; flex:none; border-radius:50%; display:grid; place-items:center; background:var(--surface-2); color:var(--warn)}
.soldout b{display:block; font-size:17px; color:var(--warn)}
.soldout span{font-size:15px; color:var(--muted)}

/* inline buy box (desktop only; phone uses the floating .abar) */
.buy{display:none; margin-top:14px; gap:10px; align-items:center}
.buy .pill{flex:1}

/* facts card: composition, allergens, nutrition */
.fcard{margin-top:24px}
.fcard .core{padding:4px 20px}
.fblk{padding:18px 0}
.fblk + .fblk{border-top:1px solid var(--line)}
.fblk .h3{margin-bottom:10px}
.comp{margin:0; font-size:17px; line-height:1.6}
.comp .ing{white-space:nowrap}
.comp .dot{color:var(--muted); padding:0 2px 0 6px; font-weight:800}
.algs{display:flex; flex-wrap:wrap; gap:10px 18px; margin:2px 0 12px; list-style:none; padding:0}
.alg{display:inline-flex; align-items:center; gap:10px; font-weight:700; font-size:16px}
.alg .ico{width:40px; height:40px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2)}
.alg.diet .ico{background:transparent; box-shadow:inset 0 0 0 1.5px var(--line)}
.alg.diet .ic{color:var(--ok)}
.alg.diet .ico{width:36px; height:36px}
.algnone{margin:0 0 12px; font-size:16px; font-weight:600}
.fblk .link{min-height:48px; margin-top:4px}
.ask{display:flex; flex-wrap:wrap; gap:8px; margin-top:12px}
details.nutr{padding:0}
details.nutr summary{list-style:none; display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:64px; cursor:pointer; font-weight:800; font-size:20px; letter-spacing:-.02em}
details.nutr summary::-webkit-details-marker{display:none}
details.nutr summary .ic{transition:transform var(--t-base) var(--ease)}
details.nutr[open] summary .ic{transform:rotate(180deg)}
details.nutr .kv{font-size:16px}
details.nutr .kv span:first-child{font-weight:600}
.nbody{padding-bottom:16px}

/* pairing / similar cards */
.pairs{display:grid; gap:10px}
.pcard{display:grid; grid-template-columns:76px 1fr 48px; gap:14px; align-items:center; padding:10px 12px 10px 10px; border-radius:var(--r-core); background:var(--surface); box-shadow:var(--hi), var(--shadow)}
.pcard .open{display:contents; color:inherit; text-decoration:none}
.pcard .pic{width:76px; height:76px; border-radius:18px}
.pcard .eb{display:block; font-size:14px; font-weight:700; color:var(--muted); line-height:1.2}
.pcard .nm{display:block; font-weight:700; font-size:16px; line-height:1.25; margin-top:2px}
.pcard .meta{display:flex; gap:10px; align-items:baseline; margin-top:4px; font-size:15px}
.subsec{margin-top:28px}
.subsec .h3{margin-bottom:12px}

/* modifier sheet */
.mgrp{padding:6px 0 14px}
.mgrp + .mgrp{border-top:1px solid var(--line); padding-top:16px}
.mgrp-h{display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin-bottom:4px}
.mgrp-h h3{margin:0; font-size:19px; letter-spacing:-.02em}
.mgrp-h span{font-size:14px; color:var(--muted); font-weight:600}
.mrow{display:grid; grid-template-columns:24px 1fr auto; gap:14px; align-items:center; min-height:52px; padding:4px 0; cursor:pointer; font-size:16px; font-weight:600}
.mrow + .mrow{border-top:1px solid var(--line)}
.mrow input{width:24px; height:24px; margin:0; accent-color:var(--red)}
.mrow .pr{font-variant-numeric:tabular-nums; font-weight:700; color:var(--muted); white-space:nowrap}
.mrow input:checked ~ .pr{color:var(--ink)}
.mrow input:checked + span{font-weight:800}
.mempty{margin:6px 0 0; font-size:15px; color:var(--muted)}
.mfoot{flex:none; display:grid; gap:8px; padding-top:12px; border-top:1px solid var(--line); margin:0 -18px; padding-left:18px; padding-right:18px}
.mfoot .tot{display:flex; justify-content:space-between; font-size:15px; font-weight:700; color:var(--muted)}
.mfoot .tot b{color:var(--ink); font-variant-numeric:tabular-nums}
.mfoot .row .pill{flex:1}
.mfoot .link{min-height:48px; justify-content:center; color:var(--muted)}
.mfoot .link[hidden]{display:none}

/* sticky action bar */
.dish-abar .counter{background:var(--surface-2)}
.dish-abar .pill .q, .buy .pill .q{opacity:.85; font-weight:700}
.abar.out .soldlbl{flex:none; display:inline-flex; align-items:center; gap:8px; padding:0 6px 0 12px; font-weight:800; font-size:16px; color:var(--warn); white-space:nowrap}

@container app (max-width:899px){
  .device[data-page="dish"] .foot{padding-bottom:200px}
}
@container app (min-width:700px){
  .pairs.cols{grid-template-columns:repeat(3,1fr)}
}
@container app (min-width:900px){
  .dish{padding:28px max(40px, calc((100% - 1200px)/2)) 0}
  .dgrid{grid-template-columns:minmax(0,1.08fr) minmax(0,1fr); gap:56px; align-items:start}
  .dish .hero{position:sticky; top:176px}
  .dish .h1{font-size:52px}
  .prow2 .price{font-size:34px}
  .buy{display:flex}
  .dish-abar{display:none}
  .aifab.up{bottom:24px}
  .top.back .ttl{opacity:1; transform:none; text-align:center}
  .sheet .mfoot{margin:0 -18px}
}
</style>

<script>
  /* Speed: only the shared runtime (sc.ts) and the light renderers (_dish-ui.ts) load at start. The menu, the illustrations
     and "Върви добре с" (_dish.ts) load only when the cart is not empty (the server already drew them for an empty cart). */
  import { SC } from "../../../client/sc.ts";
  import {
    compList, canAdd, extra, modsList, modBtnInner, buyHTML, buyLabel, closedNote, favHTML, type Rem, type Add, type DishLite, type Addon,
  } from "./_dish-ui.ts";
  /* icons this script draws itself (the rest come from _dish-ui.ts) */
  import "../../../lib/icons/arrow-left.ts";
  import "../../../lib/icons/check.ts";
  import "../../../lib/icons/cube.ts";
  import "../../../lib/icons/image.ts";

  const { esc, ic, fmt } = SC;
  const main = SC.mount();
  const art = main.querySelector<HTMLElement>("[data-dish]")!;
  const J = JSON.parse(art.querySelector("[data-dishjson]")!.textContent || "{}") as { x: DishLite; addons: Addon[] };
  const x = J.x, ADDONS = J.addons;
  const out = !!x.out;
  const top = document.querySelector<HTMLElement>(".top.back")!;
  const ttl = top.querySelector<HTMLElement>(".ttl")!;
  const backA = top.querySelector<HTMLAnchorElement>("a.hb")!;
  let qty = 1, rem: Rem = {}, add: Add = {};
  const unit = () => x.p + extra(ADDONS, add);

  /* ---------- back: to the category when we came from it, else the menu. The crumb link is the category address as
     written in the page (relative in the demo), so it works from any sub-folder too. ---------- */
  try {
    const catA = art.querySelector<HTMLAnchorElement>("[data-catlink]")!;
    const norm = (u: URL) => u.pathname.replace(/index\.html$/, "");
    const ref = document.referrer ? new URL(document.referrer) : null;
    if (ref && ref.origin === location.origin && norm(ref) === norm(new URL(catA.href))) {
      backA.href = catA.getAttribute("href")!;
      backA.innerHTML = ic("arrow-left", 20) + esc(art.dataset.catn || "Меню");
    }
  } catch { /* keep the menu */ }

  /* ---------- hour: "kitchen closed" note ---------- */
  const slot = main.querySelector<HTMLElement>("[data-closedslot]")!;
  function paintClosed() {
    const st = SC.state();
    const h = closedNote(st.kitchen, st.m, out);
    if (slot.innerHTML !== h) slot.innerHTML = h;
  }
  paintClosed();
  document.addEventListener("sc:tick", paintClosed);

  /* ---------- "Върви добре с" for the current cart ---------- */
  const pairsBox = main.querySelector<HTMLElement>("[data-pairs]")!;
  const inCart = SC.cart.lines().map((l) => l.id);
  if (inCart.length && !out) {
    Promise.all([import("../../../client/sc-menu.ts"), import("./_dish.ts")]).then(([m, d]) => {
      const h = d.pairsHTML(m.SC.byId[x.id], inCart, m.SC.MANUAL_PAIRS);
      if (pairsBox.innerHTML !== h) pairsBox.innerHTML = h;
    }).catch(() => { /* keep the pairs drawn by the server */ });
  }

  /* ---------- favourites: per-viewer list (sc-fav) + the profile when signed in ---------- */
  type U = { favs?: string[] } | null;
  function favs(): string[] {
    const f = SC.load<string[]>("sc-fav", []), u = SC.user() as U;
    return Array.from(new Set([...(Array.isArray(f) ? f : []), ...(u && Array.isArray(u.favs) ? u.favs : [])]));
  }
  const favBtn = main.querySelector<HTMLElement>("[data-fav]");
  if (favBtn) favBtn.outerHTML = favHTML(favs().indexOf(x.id) > -1);
  function toggleFav(btn: HTMLElement) {
    const f = favs(), i = f.indexOf(x.id), on = i < 0;
    if (on) f.push(x.id); else f.splice(i, 1);
    SC.store("sc-fav", f);
    btn.setAttribute("aria-pressed", String(on)); btn.classList.remove("pop"); void btn.offsetWidth; if (on) btn.classList.add("pop");
    SC.toast(on ? "Добавено в любими ♥" : "Махнато от любими");
    if (SC.user()) import("../../../client/api.ts").then(({ api }) => api.auth.toggleFav(x.id)).catch(() => { /* kept locally */ });
  }

  /* ---------- buy box + bar ---------- */
  function paint() {
    if (out) return;
    const mb = main.querySelector<HTMLElement>("[data-mods]");
    if (mb) { mb.classList.toggle("has", modsList(x, ADDONS, rem, add).length > 0); mb.innerHTML = modBtnInner(x, ADDONS, rem, add); }
    const h = buyHTML(x, qty, unit());
    const bx = main.querySelector<HTMLElement>("[data-buybox]"); if (bx) bx.innerHTML = h;
    const bar = SC.ov.querySelector<HTMLElement>(".dish-abar"); if (bar) bar.innerHTML = h;
  }

  function buy(btn: HTMLElement) {
    /* name and price go with the line, so the cart does not need to load the menu here */
    const m = modsList(x, ADDONS, rem, add), opts = { n: x.n, p: x.p, ...(m.length ? { mods: m, extra: Math.round(extra(ADDONS, add) * 100) / 100 } : {}) };
    const n = qty, t = unit() * qty;
    SC.cart.add(x.id, qty, opts);
    SC.fly(btn, x.id); SC.haptic();
    document.querySelectorAll<HTMLElement>("[data-buy]").forEach((b) => { b.classList.add("done"); b.innerHTML = ic("check", 22) + "Добавено" + (n > 1 ? " " + n + " бр." : "") + (x.per100 ? "" : " · " + fmt(t)); });
    setTimeout(paint, 1400);
    SC.toast("Добавено ✓");
  }

  /* ---------- "Добавки и промени" sheet ---------- */
  function openMods() {
    const c = compList(x);
    let html = '<p class="muted" style="margin:0 0 10px;font-size:15px">' + esc(x.n) + " · " + fmt(x.p) + "</p>";
    html += '<div class="mgrp"><div class="mgrp-h"><h3>Махни</h3><span>безплатно</span></div>' +
      (c.length ? c.map((s, i) => '<label class="mrow"><input type="checkbox" data-rem="' + i + '"' + (rem[i] ? " checked" : "") + "><span>Без " + esc(s) + '</span><span class="pr"></span></label>').join("")
        : '<p class="mempty">Нямаме още състава на това ястие. Ако искате да махнем нещо, напишете го в бележката към поръчката.</p>') + "</div>";
    if (canAdd(x)) html += '<div class="mgrp"><div class="mgrp-h"><h3>Добави</h3><span>цената се добавя</span></div>' +
      ADDONS.map((a) => '<label class="mrow"><input type="checkbox" data-addon="' + a.id + '"' + (add[a.id] ? " checked" : "") + "><span>" + esc(a.n) + '</span><span class="pr">+' + fmt(a.p) + "</span></label>").join("") + "</div>";
    /* "Смени" (swap one ingredient for another) stays hidden until the owner switches it on (hand-off 6.3, master 7 q_swap). */
    const s = SC.sheet({ title: "Добавки и промени", html, onClose: paint });
    const sheet = s.el.querySelector<HTMLElement>(".sheet")!;
    sheet.insertAdjacentHTML("beforeend", '<div class="mfoot"><div class="tot"><span data-totl></span><b data-tot></b></div><div class="row"><button class="pill pill-red pill-lg" type="button" data-sbuy></button></div><button class="link" type="button" data-sreset hidden>Изчисти промените</button></div>');
    const $ = (sel: string) => sheet.querySelector<HTMLElement>(sel)!;
    function upd() {
      const has = modsList(x, ADDONS, rem, add).length > 0;
      $("[data-tot]").textContent = fmt(unit() * qty);
      $("[data-totl]").textContent = (has ? "С промените, " : "Общо, ") + qty + " бр.";
      $("[data-sbuy]").innerHTML = buyLabel(x, qty, unit());
      $("[data-sreset]").hidden = !has;
    }
    upd();
    sheet.addEventListener("change", (e) => {
      const el = e.target as HTMLInputElement;
      if (el.dataset.rem != null) rem[el.dataset.rem] = el.checked;
      if (el.dataset.addon) add[el.dataset.addon] = el.checked;
      upd();
    });
    $("[data-sreset]").onclick = () => { rem = {}; add = {}; sheet.querySelectorAll<HTMLInputElement>("input[type=checkbox]").forEach((i) => { i.checked = false; }); upd(); };
    $("[data-sbuy]").onclick = function (this: HTMLElement) {
      const b = this; s.close();
      setTimeout(() => {
        let t = document.querySelector<HTMLElement>(".dish-abar [data-buy]");
        if (!t || !t.offsetParent) t = main.querySelector<HTMLElement>("[data-buybox] [data-buy]");
        buy(t || b);
      }, 60);
    };
  }

  /* ---------- 3D (slow-device path: photo first, 3D only on tap; the real model comes after the photo session) ---------- */
  let ang = 0, tilt = 54, drag: { x: number; y: number; a: number; t: number; svg: SVGElement } | null = null;
  const set3d = (svg: SVGElement) => { svg.style.transform = "perspective(900px) rotateX(" + tilt + "deg) rotateZ(" + ang + "deg)"; };
  function toggle3d(btn: HTMLElement) {
    const pic = main.querySelector<HTMLElement>(".hero .pic")!, svg = pic.querySelector<SVGElement>("svg")!;
    const note = main.querySelector<HTMLElement>("[data-note3d]")!, hint = main.querySelector<HTMLElement>(".hint3d")!;
    if (pic.classList.contains("is3d")) {
      pic.classList.remove("is3d"); pic.removeAttribute("tabindex"); svg.style.transition = "transform var(--t-slow) var(--ease)"; svg.style.transform = "none";
      btn.innerHTML = ic("cube", 20) + "Виж в 3D"; note.hidden = true; return;
    }
    btn.setAttribute("aria-busy", "true"); btn.innerHTML = '<span class="spin" aria-hidden="true"></span>Зарежда 3D'; pic.classList.add("loading");
    setTimeout(() => {
      pic.classList.remove("loading"); pic.classList.add("is3d"); pic.tabIndex = 0;
      pic.setAttribute("aria-label", x.n + ", 3D изглед. Завъртете с плъзгане или със стрелките.");
      btn.removeAttribute("aria-busy"); btn.innerHTML = ic("image", 20) + "Снимка"; note.hidden = false;
      ang = 0; tilt = 54; svg.style.transition = "transform 700ms var(--ease)"; set3d(svg);
      if (!SC.reduce) setTimeout(() => { if (!pic.classList.contains("is3d")) return; svg.style.transition = "transform 2200ms var(--ease)"; ang = 360; set3d(svg); }, 720);
      hint.classList.add("on"); setTimeout(() => hint.classList.remove("on"), 2600);
    }, 900);
  }
  main.addEventListener("pointerdown", (e) => {
    const t = e.target as Element, pic = t.closest<HTMLElement>(".hero .pic.is3d");
    if (!pic || t.closest("button")) return;
    drag = { x: e.clientX, y: e.clientY, a: ang, t: tilt, svg: pic.querySelector<SVGElement>("svg")! };
    drag.svg.style.transition = "none";
    try { pic.setPointerCapture(e.pointerId); } catch { /* ignore */ }
  });
  main.addEventListener("pointermove", (e) => { if (!drag) return; ang = drag.a + (e.clientX - drag.x) * .7; tilt = Math.max(15, Math.min(66, drag.t - (e.clientY - drag.y) * .25)); set3d(drag.svg); });
  ["pointerup", "pointercancel"].forEach((ev) => main.addEventListener(ev, () => { drag = null; }));
  main.addEventListener("keydown", (e) => {
    const pic = (e.target as Element).closest?.(".hero .pic.is3d"); if (!pic) return;
    const k = ({ ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -6], ArrowDown: [0, 6] } as Record<string, number[]>)[e.key]; if (!k) return;
    e.preventDefault();
    ang += k[0]; tilt = Math.max(15, Math.min(66, tilt + k[1]));
    const svg = pic.querySelector<SVGElement>("svg")!; svg.style.transition = "transform var(--t-base) var(--ease)"; set3d(svg);
  });

  /* ---------- events ---------- */
  function onClick(e: Event) {
    const t = (e.target as Element).closest<HTMLElement>("button, a"); if (!t) return;
    if (t.dataset.q) { qty = Math.max(1, Math.min(20, qty + (+t.dataset.q))); paint(); return; }
    if (t.hasAttribute("data-buy")) { buy(t); return; }
    if (t.hasAttribute("data-mods")) { openMods(); return; }
    if (t.hasAttribute("data-fav")) { toggleFav(t); return; }
    if (t.hasAttribute("data-3d")) { if (!t.hasAttribute("aria-busy")) toggle3d(t); return; }
    if (t.hasAttribute("data-tosim")) {
      e.preventDefault();
      const s = main.querySelector("#similar");
      if (s) window.scrollTo({ top: s.getBoundingClientRect().top + window.scrollY - 150, behavior: SC.reduce ? "auto" : "smooth" });
    }
  }
  main.addEventListener("click", onClick);
  SC.ov.addEventListener("click", (e) => { if ((e.target as Element).closest(".dish-abar")) onClick(e); });

  /* ---------- the dish name slides into the back bar once the H1 is out of view ---------- */
  const h1 = main.querySelector("[data-h1]");
  if (h1 && "IntersectionObserver" in window) {
    new IntersectionObserver((es) => { const en = es[0]; ttl.classList.toggle("on", !en.isIntersecting && en.boundingClientRect.top < 200); }, { root: null, rootMargin: "-150px 0px 0px 0px" }).observe(h1);
  }

  SC.reveal();
</script>
