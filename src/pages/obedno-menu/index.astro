---
/* Lunch menu (/obedno-menu/): port of design/pages/lunch.html (design/PAGES.md "lunch.html", decision 19, BRIEF 8).
   The server draws everything that does not depend on the hour: the H1 with the menu's date (never "днес": the build
   does not know today's date), the groups with every dish and price, the week (preview only), office, FAQ and JSON-LD
   (Menu > MenuSection > MenuItem, BreadcrumbList, FAQPage). The browser adds the hour (delivery or pickup until 15:00,
   -30% pickup only until 22:30, closed before 10:00 and after 22:30), the date check (lunchIsToday), the cart bar
   and, only in preview (?preview=1), the "Изчерпано днес" mock and the states panel.
   SPEED: the script uses the small runtime (client/sc.ts), not sc-menu.ts: the 20 dishes are already in the HTML, so the
   rows are updated in place from data-id / data-p and the menu (lib/data.ts, pricing, illustrations) is never loaded. */
import Base from "../../layouts/Base.astro";
import { h1HTML, leadHTML, uploadNoteHTML, todayCardHTML, serverView } from "./_lunch.ts";
import { meta, listHTML, bottomHTML, lunchLd, dateText } from "./_lunch-server.ts";
import { fmt } from "../../lib/format.ts";

const M = meta();
const v = serverView(M);
const description = "Обедното меню на Siracusa в Дружба 2: " + M.count + " ястия от " + fmt(M.minP) + ", ново всеки ден. С доставка до 15:00 и -30% при вземане от място след 15:00.";
---
<Base page="lunch" nav="lunch" title="Обедно меню" description={description} jsonld={lunchLd(Astro.site)}>
  <div class="lgrid" data-lunch data-date={M.date} data-dayname={M.dayName} data-count={M.count} data-minp={M.minP}>
    <section class="sec lhero" aria-labelledby="lh1">
      <h1 class="h1" id="lh1" data-h1 set:html={h1HTML(v)}></h1>
      <p class="lead" data-lead set:html={leadHTML(v)}></p>
      <div data-upl set:html={uploadNoteHTML(v, false)}></div>
      <div data-deal></div>
      <div class="shell today" data-today set:html={todayCardHTML(v)}></div>
    </section>
    <div class="sec lmain" data-list aria-label={"Ястията в обедното меню за " + dateText(M)} set:html={listHTML(v)}></div>
  </div>
  <Fragment set:html={bottomHTML(v)} />
  <div data-proto></div>
  <div class="abar" slot="ov" data-abar hidden><span class="asum" hidden data-asum></span><span data-cta style="flex:1;display:flex"></span></div>
</Base>

<style is:global>
/* lunch page only (design/pages/lunch.html), tokens from tokens.css */

/* ---------- layout ---------- */
.lgrid{display:grid; grid-template-columns:minmax(0,1fr); gap:0}
.lhero{padding-top:24px}
.lmain{padding-top:40px}
@container app (min-width:900px){
  .lgrid{grid-template-columns:minmax(0,380px) minmax(0,1fr); gap:56px; align-items:start; padding:48px max(40px, calc((100% - 1200px)/2)) 0}
  .lgrid > .sec{padding-left:0; padding-right:0; padding-top:0}
  .lhero.stick{position:sticky; top:168px}
  .lmain{padding-top:0}
}
@container app (min-width:1100px){ .lgrid{grid-template-columns:minmax(0,400px) minmax(0,1fr); gap:64px} }

/* ---------- hero ---------- */
.eb{display:flex; align-items:center; gap:8px; font-size:15px; line-height:1.2; letter-spacing:0; font-weight:800; color:var(--muted); margin-bottom:12px}
.eb .ic{color:var(--red)}
.h1 .dt{display:block}
.lhero .lead{margin-top:12px; max-width:34ch}

/* ---------- -30% banner (ember) ---------- */
.deal{margin-top:22px; border-radius:var(--r-shell); padding:20px 20px 22px; box-shadow:var(--shadow)}
.deal .top2{display:flex; align-items:center; justify-content:space-between; gap:12px}
.deal .big{font-size:60px; line-height:.9; font-weight:800; letter-spacing:-.06em; font-variant-numeric:tabular-nums}
.deal .ill{width:56px; height:56px; border-radius:50%; display:grid; place-items:center; background:var(--on-ember); color:var(--ember); flex:none}
.deal b{display:block; margin-top:10px; font-size:22px; line-height:1.15; letter-spacing:-.025em}
.deal p{margin:8px 0 0; font-size:16px; line-height:1.4}

/* ---------- "today" card with day timeline ---------- */
.today{margin-top:18px}
.today .core{padding:18px 16px 16px}
.now-h{display:flex; align-items:flex-start; gap:10px}
.now-h .dot{width:10px; height:10px; border-radius:50%; background:var(--off); flex:none; margin-top:7px}
.now-h .dot.ok{background:var(--ok)} .now-h .dot.warn{background:var(--ember)}
.now-h b{display:block; font-size:17px; line-height:1.3; letter-spacing:-.01em}
.now-h span.sub{display:block; color:var(--muted); font-size:15px; line-height:1.35; margin-top:2px}
.now-h .clock{margin-left:auto; flex:none; font-size:14px; font-weight:800; font-variant-numeric:tabular-nums; padding:5px 10px; border-radius:999px; background:var(--surface-2)}

.tl{margin-top:18px}
.tl-bar{position:relative; height:12px; display:flex; gap:3px}
.tl-bar > span{display:block; height:100%; border-radius:6px}
.tl-bar .a{flex:300 1 0; background:var(--ok)}
.tl-bar .b{flex:450 1 0; background:var(--ember)}
.tl-past{position:absolute; inset:0; border-radius:6px; background:var(--surface); opacity:.62; transform-origin:left center; transform:scaleX(var(--x,0))}
.tl-now{position:absolute; top:50%; left:calc(var(--x,0) * 100%); width:22px; height:22px; margin:-11px 0 0 -11px; border-radius:50%; background:var(--ink); box-shadow:0 0 0 4px var(--surface), var(--shadow)}
.tl-l{position:relative; height:22px; margin-top:8px; font-size:14px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums}
.tl-l span{position:absolute; top:0}
.tl-l span:nth-child(1){left:0}
.tl-l span:nth-child(2){left:40%; transform:translateX(-50%)}
.tl-l span:nth-child(3){right:0}
.tl-k{display:flex; flex-wrap:wrap; gap:6px 16px; margin-top:6px; font-size:14px; font-weight:600}
.tl-k span{display:inline-flex; align-items:center; gap:7px}
.tl-k i{width:10px; height:10px; border-radius:50%; flex:none}
.tl-k .ka{background:var(--ok)} .tl-k .kb{background:var(--ember)}
.tl.off .tl-bar,.tl.off .tl-k i{opacity:.45}
/* the one strong motion on the page: the elapsed part of the day fills in, then the "now" dot lands */
.tl.anim .tl-past{animation:tlfill 1100ms var(--ease) both}
.tl.anim .tl-now{animation:tlpop 420ms var(--ease) 820ms both}
@keyframes tlfill{from{transform:scaleX(0)}}
@keyframes tlpop{from{transform:scale(0); opacity:0}}

.today .seg{margin-top:18px; grid-auto-columns:auto}
.today .seg button{white-space:nowrap; padding:0 8px; gap:7px; min-width:0}
@container app (max-width:380px){ .today .seg button .ic{display:none} }
.modeinfo{display:flex; gap:12px; align-items:flex-start; margin-top:14px; font-size:15px; line-height:1.4}
.modeinfo .ic{margin-top:1px; color:var(--muted)}
.modeinfo b{display:block; font-size:16px}
.modeinfo .muted{display:block}
.modeinfo.busy .ic{color:var(--warn)}
.modeinfo a{color:var(--ink); font-weight:700; text-underline-offset:3px}

/* tomorrow slot (closed hours) */
.tmrw{margin-top:14px; display:grid; grid-template-columns:48px 1fr; gap:14px; align-items:center; padding:14px; border-radius:var(--r-core); background:var(--surface-2)}
.tmrw .ill{width:48px; height:48px; border-radius:50%; display:grid; place-items:center; background:var(--surface); color:var(--muted)}
.tmrw b{display:block}

/* ---------- jump chips ---------- */
.jump{margin-bottom:8px}
@container app (min-width:900px){ .jump.chips{margin:0 0 8px; padding:2px 0; flex-wrap:wrap; overflow:visible} }
.jump .chip .ic{color:var(--muted)}

.lnote{display:flex; gap:12px; align-items:flex-start; margin:8px 0 0; padding:14px 16px; border-radius:var(--r-core); background:var(--surface-2); font-size:16px; line-height:1.45}
.lnote.upl{margin-top:16px}
.lnote .ic{margin-top:1px; flex:none}
.lnote b{display:block; font-size:16px}
.lnote.warn .ic{color:var(--warn)}

/* ---------- groups ---------- */
.grp{scroll-margin-top:150px}
.grp + .grp{margin-top:32px}
.grp-h{display:flex; align-items:center; gap:12px; margin:0 4px 12px}
.grp-h .gi{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--surface); box-shadow:var(--hi), var(--shadow); flex:none}
.grp-h h2{flex:1; min-width:0}
.grp-h .n{font-size:14px; font-weight:700; color:var(--muted); white-space:nowrap}
.grp-h .n.disc{color:var(--on-ember); background:var(--ember); padding:5px 10px; border-radius:999px}
.lrows{list-style:none; margin:0; padding:0 16px}
.lrow{display:grid; grid-template-columns:64px minmax(0,1fr) 48px; gap:14px; align-items:center; padding:12px 0; min-height:88px}
.lrow + .lrow{border-top:1px solid var(--line)}
.lrow .pic{width:64px; height:64px; border-radius:18px}
.lrow .nm{display:block; font-weight:700; font-size:16px; line-height:1.3; letter-spacing:-.005em; text-wrap:pretty}
.lrow .meta{display:flex; flex-wrap:wrap; align-items:baseline; gap:4px 10px; margin-top:4px}
.lrow .meta .price{font-size:17px}
.lrow .meta .old{font-size:15px; font-variant-numeric:tabular-nums}
.lrow.out .nm{color:var(--muted)}
.lrow.out .meta .price{color:var(--muted); font-weight:700}
.lrow .meta .badge{align-self:center}
.lrow .slot{width:48px; height:48px}
.lrow.locked .meta .when{font-size:14px; color:var(--muted); font-weight:600}
@container app (min-width:900px){
  .grp{scroll-margin-top:170px}
  .lrows{padding:0 22px}
  .lrow{grid-template-columns:72px minmax(0,1fr) 48px; gap:18px; min-height:96px}
  .lrow .pic{width:72px; height:72px; border-radius:20px}
  .lrow .nm{font-size:17px}
  .lrow .lt{display:flex; align-items:center; justify-content:space-between; gap:24px}
  .lrow .meta{margin-top:0; flex:none; flex-wrap:nowrap; align-items:center}
  .lrow .meta .price{font-size:18px}
}

/* skeleton rows */
.sk-row{display:grid; grid-template-columns:64px 1fr; gap:14px; align-items:center; padding:12px 0; min-height:88px}
.sk-row + .sk-row{border-top:1px solid var(--line)}
.sk-row .skel.p{width:64px; height:64px; border-radius:18px}
.sk-row .skel.l1{height:16px; width:78%}
.sk-row .skel.l2{height:14px; width:34%; margin-top:10px}

/* ---------- week ---------- */
.week{display:flex; gap:10px; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; padding:2px 16px 8px; margin:0 -16px; scroll-padding:0 16px}
.week::-webkit-scrollbar{display:none}
.day{flex:0 0 156px; scroll-snap-align:start; display:flex; flex-direction:column; gap:8px; min-height:164px; padding:16px; border-radius:var(--r-core); background:var(--surface); box-shadow:var(--hi), var(--shadow)}
.day .dn{display:flex; align-items:baseline; justify-content:space-between; gap:6px}
.day .dn b{font-size:20px; letter-spacing:-.03em}
.day .dn span{font-size:14px; font-weight:700; color:var(--muted); font-variant-numeric:tabular-nums}
.day .cnt2{font-size:22px; font-weight:800; letter-spacing:-.03em; line-height:1.1; margin-top:auto}
.day .from{font-size:16px; font-weight:600; opacity:.75}
.day.empty-day{background:transparent; box-shadow:inset 0 0 0 1.5px var(--line-strong)}
.day.empty-day .ic{margin-top:auto; color:var(--muted)}
.day .missing{font-size:14px; line-height:1.35}
.day .tag{align-self:flex-start; font-size:14px; font-weight:800; padding:4px 9px; border-radius:999px; background:var(--surface-2)}
.day.is-today{background:var(--chip-dark); color:var(--on-chip-dark)}
.day.is-today .dn span{color:var(--on-chip-dark); opacity:.7}
.day.is-today .tag{background:var(--ember); color:var(--on-ember)}
.day.past{opacity:.6}
.day.has-menu .tag{background:var(--surface-2)}
@container app (min-width:900px){
  .week{display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); overflow:visible; margin:0; padding:2px 0}
  .day{min-height:210px}
}

/* ---------- office + faq ---------- */
.duo{display:grid; gap:16px}
@container app (min-width:900px){ .duo{grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:24px; align-items:start} }
.office .core{padding:22px; display:grid; gap:12px}
.office .ill{width:56px; height:56px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2)}
.office p{margin:0}
.office ol{margin:0; padding:0; list-style:none; display:grid; gap:10px; counter-reset:s}
.office li{display:grid; grid-template-columns:28px 1fr; gap:10px; align-items:start; counter-increment:s; font-size:15px; line-height:1.4}
.office li::before{content:counter(s); width:28px; height:28px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2); font-weight:800; font-size:14px}
.office .pill{margin-top:6px; justify-self:start}

.faq .faq-head{margin:0 4px 14px}
.faq .core{padding:4px 20px}
.lnote-h{margin:0 0 20px}
.faq details + details{border-top:1px solid var(--line)}
.faq summary{list-style:none; display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:60px; padding:12px 0; font-weight:700; font-size:16px; line-height:1.3; cursor:pointer}
.faq summary::-webkit-details-marker{display:none}
.faq summary .ic{transition:transform var(--t-base) var(--ease); color:var(--muted)}
.faq details[open] summary .ic{transform:rotate(180deg)}
.faq details p{margin:0 0 16px; color:var(--muted); font-size:16px; line-height:1.5}


/* ---------- action bar ---------- */
.abar .asum{flex:none; padding:0 4px 0 12px; display:grid; line-height:1.2}
.abar [data-cta] .pill{padding:0 14px; min-width:0}
.abar .asum b{font-size:16px; font-variant-numeric:tabular-nums}
.abar .asum small{font-size:14px; font-weight:600; color:var(--muted)}
.abar .asum[hidden],.abar[hidden]{display:none}
.lhero [data-upl]:empty,.lhero [data-deal]:empty{display:none}
.lnote a.tel{color:var(--ink); font-weight:700; display:inline-flex; align-items:center; min-height:48px}
.grps{margin-top:12px}
.sk-row .skel.l1,.sk-row .skel.l2{display:block}
</style>

<script>
  /* the small runtime only (no menu): the dishes, their prices and "+" are in the server HTML (data-id, data-p) */
  import { SC } from "../../client/sc.ts";
  import { previewPanel, pvChip, PV } from "../../lib/ui.ts";
  import "sc-icons:arrow-right,bowl-food,calendar-blank,calendar-dots,caret-down,clock,eye,fork-knife,moped,plus,sliders-horizontal,storefront,warning,warning-circle"; /* one module (scripts/icon-groups.mjs) */
  import {
    phaseOf, canOrderIn, h1HTML, leadHTML, uploadNoteHTML, dealHTML, todayCardHTML, modeInfoHTML, weekHTML,
    metaHTML, plusHTML, SLOT, lockedNote, offlineNote, skeletonHTML, emptyHTML, errorHTML, clockText, DISC_PCT,
    type View, type Phase, type Meta,
  } from "./_lunch.ts";

  const main = SC.mount({ docTitle: "Обедно меню" });
  const root = main.querySelector<HTMLElement>("[data-lunch]")!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => main.querySelector<T>(s)!;
  const ic = SC.ic;
  const ds = root.dataset;
  const M: Meta = { date: ds.date || "", dayName: ds.dayname || undefined, count: +(ds.count || 0), minP: +(ds.minp || 0) };
  const list = $("[data-list]");

  /* MOCK (макет): демонстрира „Изчерпано днес“ само в преглед (?preview=1, демото). В истинския сайт идва от наличността на обедното меню (админ). */
  const MOCK_OUT = ["l-teleshko-sas-spanak-i-oriz"];
  if (SC.preview) MOCK_OUT.forEach((id) => {
    const li = list.querySelector<HTMLElement>('.lrow[data-id="' + id + '"]');
    if (!li || li.classList.contains("out")) return;
    li.classList.add("out"); li.querySelector(".pic")?.classList.add("out");
    li.parentElement!.appendChild(li); /* sold out stays visible, last in its group (decision 2) */
  });
  /* the lunch dishes on this page: id -> price (for the bar total and the pickup switch), and the sold out ones */
  const LUNCH: Record<string, number> = {}, OUT = new Set<string>();
  list.querySelectorAll<HTMLElement>(".lrow[data-id]").forEach((li) => { LUNCH[li.dataset.id!] = +li.dataset.p!; if (li.classList.contains("out")) OUT.add(li.dataset.id!); });
  const LIST0 = list.innerHTML; /* the server list (with the mock), restored after the preview states */
  let listState = "";

  /* lunch lives under "Меню" in the phone tab bar; Base marks only one key, so mark the tab here (see the report) */
  const tab = SC.ov.querySelector('.nav a[href="' + SC.url.menu() + '"]');
  if (tab) tab.setAttribute("aria-current", "page");

  /* BRIEF 8: the menu in the data is for one date; on another day it is never "днес" and (real site) not orderable */
  const isToday = !!M.date && SC.lunchIsToday(); /* preview / demo: today (one helper for every page) */
  ds.isToday = isToday ? "1" : "0";
  let phase: Phase = phaseOf(SC.state());

  type Demo = "" | "loading" | "empty" | "error" | "offline";
  const DEMOS: [Demo, string][] = [["", PV.normal], ["loading", PV.loading], ["empty", PV.empty], ["error", PV.error], ["offline", PV.offline]];
  const demo = (): Demo => {
    if (!SC.preview) return "";
    const h = (location.hash || "").replace("#", "") as Demo;
    return DEMOS.some((d) => d[0] === h) ? h : "";
  };

  function view(): View {
    const now = SC.now();
    return {
      meta: M, phase, isToday, orderable: canOrderIn(phase) && isToday,
      mode: SC.cart.mode() === "pickup" ? "pickup" : "delivery", eta: SC.eta(), clock: clockText(now.h, now.m), reduce: SC.reduce, m: SC.state().m,
    };
  }

  /* the bar total without the menu: lunch dishes at the page's price, -30% when picked up after 15:00 (same rounding as
     lib/pricing.ts price()); other lines at the price saved in the cart. The cart page recomputes it from the menu. */
  const r2 = (n: number) => Math.round(n * 100) / 100;
  function barTotal(): number {
    const c = SC.cart.get(), lunchOn = phase === "discount" && (c.mode === "pickup" || !SC.state().delivery);
    let sub = 0, disc = 0;
    for (const l of c.lines) {
      if (OUT.has(l.id)) continue;
      const lp = LUNCH[l.id], tot = r2(((lp ?? l.p ?? 0) + (lp == null ? l.extra || 0 : 0)) * l.q);
      sub += tot;
      if (lp != null && lunchOn) disc += Math.round(tot * DISC_PCT) / 100;
    }
    return r2(sub - disc);
  }
  const hasLunch = () => SC.cart.lines().some((l) => LUNCH[l.id] != null);

  /* ---------- action bar: one main action (only while the lunch menu can be ordered) ---------- */
  const abar = SC.ov.querySelector<HTMLElement>("[data-abar]")!;
  const fab = SC.ov.querySelector<HTMLElement>(".aifab");
  function updateBar() {
    const v = view(), d = demo(), on = v.orderable && d !== "loading" && d !== "empty" && d !== "error";
    abar.hidden = !on;
    if (fab) fab.classList.toggle("up", on);
    if (!on) return;
    const n = SC.cart.count(), sum = abar.querySelector<HTMLElement>("[data-asum]")!, cta = abar.querySelector<HTMLElement>("[data-cta]")!;
    const verb = phase === "discount" ? "Поръчай за вземане" : "Поръчай";
    sum.hidden = !n;
    sum.innerHTML = n ? "<b>" + SC.plural(n, "ястие", "ястия") + "</b><small>в количката</small>" : "";
    cta.innerHTML = n ? '<a class="pill pill-red" href="' + SC.url.cart() + '">' + verb + " · " + SC.fmt(barTotal()) + "</a>"
      : '<button class="pill pill-red" type="button" data-jump="first">' + (phase === "discount" ? "Поръчай за вземане · -" + DISC_PCT + "%" : "Поръчай") + ic("caret-down", 20) + "</button>";
  }

  /* ---------- render the hour-dependent parts ---------- */
  function renderHero() {
    const v = view(), d = demo(), bare = d === "loading" || d === "empty" || d === "error";
    $("[data-h1]").innerHTML = h1HTML(v);
    $("[data-lead]").innerHTML = leadHTML(v, bare);
    $("[data-upl]").innerHTML = uploadNoteHTML(v, SC.preview);
    $("[data-deal]").innerHTML = dealHTML(v);
    $("[data-today]").innerHTML = todayCardHTML(v);
    $("[data-week]").innerHTML = weekHTML(v);
  }
  /* the rows of the server HTML, updated in place: price (-30% after 15:00), "Изчерпано днес", "+" or an empty slot */
  function updateRows(v: View) {
    const can = canOrderIn(v.phase) && v.orderable;
    list.querySelectorAll<HTMLElement>(".lrow[data-id]").forEach((li) => {
      const id = li.dataset.id!, p = +li.dataset.p!, out = OUT.has(id), plus = can && !out;
      li.classList.toggle("locked", !can);
      li.querySelector(".meta")!.innerHTML = metaHTML(p, v.phase === "discount" && v.orderable, out);
      const last = li.lastElementChild as HTMLElement;
      if (plus !== last.classList.contains("plus")) last.outerHTML = plus ? plusHTML(id, p, li.querySelector(".nm")!.textContent || "") : SLOT;
    });
  }
  function renderList() {
    const d = demo(), v = view();
    if (d === "loading" || d === "empty" || d === "error") {
      list.innerHTML = d === "loading" ? skeletonHTML() : d === "empty" ? emptyHTML() : errorHTML();
    } else {
      if (listState) list.innerHTML = LIST0;
      $("[data-lnotes]").innerHTML = (d === "offline" || navigator.onLine === false ? offlineNote() : "") + lockedNote(v);
      updateRows(v);
    }
    listState = d === "offline" ? "" : d;
    const p = main.querySelector("[data-demos]");
    if (p) p.innerHTML = DEMOS.map((x) => pvChip(x[1], d === x[0], 'data-demo="' + x[0] + '"')).join("");
    SC.reveal(list);
  }
  function render() { renderHero(); renderList(); updateBar(); fitSticky(); }

  /* preview-only: the states panel */
  if (SC.preview) {
    $("[data-proto]").outerHTML = previewPanel('<span data-demos style="display:contents"></span>', { id: "lu-pv" });
  }

  /* after 15:00 the lunch menu is pickup only (decision 19): a lunch item in the cart switches the cart to pickup */
  SC.cart.on(() => {
    if (phase === "discount" && SC.cart.mode() !== "pickup" && hasLunch()) SC.cart.mode("pickup");
    updateBar();
  });

  function jumpTo(id: string) {
    const el = id === "first" ? main.querySelector<HTMLElement>("[data-list] .grp") : document.getElementById(id);
    if (!el) return;
    const row2 = document.querySelector(".row2"), off = (row2 ? Math.max(0, row2.getBoundingClientRect().bottom) : 0) + 12;
    window.scrollTo({ top: window.scrollY + el.getBoundingClientRect().top - off, behavior: SC.reduce ? "auto" : "smooth" });
    if (id === "first") { const p = el.querySelector<HTMLElement>(".plus"); setTimeout(() => { if (p) p.focus({ preventScroll: true }); }, SC.reduce ? 0 : 500); }
  }

  main.addEventListener("click", (e) => {
    const t = (e.target as Element).closest<HTMLButtonElement>("button");
    if (!t) return;
    if (t.dataset.mode) {
      SC.cart.mode(t.dataset.mode === "pickup" ? "pickup" : "delivery");
      main.querySelectorAll("[data-mode]").forEach((b) => b.setAttribute("aria-pressed", String(b === t)));
      const mi = main.querySelector("[data-modeinfo]"); if (mi) mi.innerHTML = modeInfoHTML(view());
      return;
    }
    if (t.dataset.jump) { jumpTo(t.dataset.jump); return; }
    if (t.hasAttribute("data-demo") && SC.preview) {
      const v = t.dataset.demo;
      history.replaceState(null, "", v ? "#" + v : location.pathname + location.search);
      render();
    }
  });
  abar.addEventListener("click", (e) => { const t = (e.target as Element).closest<HTMLElement>("[data-jump]"); if (t) jumpTo(t.dataset.jump!); });
  window.addEventListener("hashchange", render);
  window.addEventListener("offline", renderList);
  window.addEventListener("online", renderList);
  /* the hour changes the page (10:00, 15:00, 22:30) and the "остават" line. At 15:00 a lunch cart for delivery becomes
     pickup (decision 19) and the visitor is told why. */
  document.addEventListener("sc:tick", () => {
    const p = phaseOf(SC.state());
    if (p === phase) { renderHero(); return; }
    phase = p;
    if (p === "discount" && view().orderable && hasLunch() && SC.cart.mode() !== "pickup") {
      SC.cart.mode("pickup");
      SC.toast("Вече е 15:00: обедното меню е само за вземане от място, с -" + DISC_PCT + "%.");
    }
    render();
  });

  /* desktop: keep the day card in view while scrolling the list, but only when it fits the screen */
  const heroEl = main.querySelector<HTMLElement>(".lhero")!;
  function fitSticky() { heroEl.classList.toggle("stick", heroEl.offsetHeight + 190 < window.innerHeight); }
  window.addEventListener("resize", fitSticky);

  ds.ready = "1";
  render();
</script>
