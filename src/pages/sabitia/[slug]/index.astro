---
/* Event (/sabitia/<slug>/): port of design/pages/event.html (design/PAGES.md "event.html", hand-off 6.8).
   One static page per event (SEO). The server draws everything that does not depend on the day: title, category,
   text, facts, program, menu slot, photos, rules, BreadcrumbList and an Event JSON-LD with the recurring schedule.
   The date of the evening ("последната събота") is computed in the browser from today: it redraws the ticket
   (calendar leaf, countdown, main action), the next evening, <title> and the action bar.
   On the server the ticket says "Всяка последна събота от месеца" instead of a date that could get stale.
   Event JSON-LD (../_ld.ts, the same as on /sabitia/): startDate with the build date in the HTML, rewritten in the
   browser with today's date in Sofia; no endDate (the end of the evening is not known). */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { ic, url, esc, events, EVENT_SLUGS, byId, dishCard, RESTAURANT as R } from "../../../lib/index.ts";
import { ticketHTML, factsHTML, rulesHTML, nextInner, barHTML, cta } from "./_event.ts";
import { eventLd, crumbsLd, sofiaToday } from "../_ld.ts";
import { crumbs, miss, photoSlot } from "../../../lib/ui.ts";

export const getStaticPaths = (() => EVENT_SLUGS.map((slug) => ({ params: { slug }, props: { slug } }))) satisfies GetStaticPaths;

const ev = events(sofiaToday()).find((e) => e.id === Astro.props.slug)!;
const site = String(Astro.site || "https://siracusa-sofia.com");
const pageUrl = new URL(url.event(ev.id), site).href;
const gs = byId["gratska-salata"];
/* one mention of "последна събота" (ev.text already says it), under 160 characters */
const description = ev.n + " от " + ev.time + " в Siracusa, Дружба 2. " + ev.text + " Запазете място: " + R.phone + ".";
const evLd = JSON.stringify(eventLd(ev, site));
---
<Base page="event" nav="events" back={{ href: url.events(), label: "Събития и поводи" }} title={ev.n} docTitle={ev.n + " | Събития"} actionBar
  description={description} jsonld={crumbsLd(site, ev)}>
  <script type="application/ld+json" id="ev-ld" slot="head" set:html={evLd} />
  <div data-ev={ev.id} data-url={pageUrl}>
    <section class="sec ev-hero">
      <div class="ev-head">
        <Fragment set:html={crumbs([["Събития и поводи", url.events()], [ev.n]])} />
        <div class="ev-eyebrow">
          <span class="ev-cat"><Fragment set:html={ic("mask-happy", 18)} />{ev.cat}</span>
          <button class="pill pill-soft ev-share" type="button" data-evshare><Fragment set:html={ic("share-network", 20)} />Сподели</button>
        </div>
        <h1 class="ev-title">{ev.n}</h1>
        <p class="lead ev-lead">{ev.text}</p>
      </div>
      <div class="ev-ticket" data-ticket set:html={ticketHTML(ev, null)}></div>
      <div class="ev-facts" data-facts set:html={factsHTML(ev, null)}></div>
    </section>
    <section class="sec rv">
      <div class="ev-cols">
        <div>
          <div class="sec-h"><h2 class="h2">Програма</h2></div>
          <ol class="tl">
            <li><span class="t">{ev.time}</span><span class="dot em"></span><div><b>Начало на вечерта</b></div></li>
            <li><span class="t muted">...</span><span class="dot miss"></span><div set:html={miss("program")}></div></li>
            <li><span class="t">{R.kitchen}</span><span class="dot"></span><div><b>Последни поръчки от кухнята</b></div></li>
            <li><span class="t">{R.close}</span><span class="dot"></span><div><b>Ресторантът затваря</b></div></li>
          </ol>
        </div>
        <div>
          <div class="sec-h"><h2 class="h2">Меню на вечерта</h2></div>
          <div class="card slot-menu"><Fragment set:html={ic("fork-knife", 24)} /><Fragment set:html={miss("eveningMenu")} /></div>
          {gs && <Fragment>
            <p class="ev-also">За гръцко настроение и у дома, от основното меню:</p>
            <div class="card ev-dish" set:html={dishCard(gs, "row")}></div>
          </Fragment>}
        </div>
      </div>
    </section>
    <section class="sec rv">
      <div class="sec-h"><h2 class="h2">Снимки от вечерта</h2></div>
      <div class="ev-mosaic" set:html={photoSlot({ of: ev.n, ratio: "", tag: "div" }) + photoSlot({ of: "ястие от вечерта", ratio: "", tag: "div" }) + photoSlot({ of: "салона вечерта", ratio: "", tag: "div" })}></div>
    </section>
    <Fragment set:html={rulesHTML(ev)} />
    <section class="sec rv">
      <div class="sec-h"><h2 class="h2">Следващата тематична вечер</h2></div>
      <div class="shell"><div class="core nx" data-next set:html={nextInner(null)}></div></div>
    </section>
  </div>
  <div class="abar ev-abar off" data-abar aria-hidden="true" inert slot="ov" set:html={barHTML(cta(null))}></div>
</Base>

<style is:global>
/* the back bar (phone): the title only after the h1 scrolls away, as on the dish page (no title three times in the first screen) */
.top.back .ttl{opacity:0; transform:translateY(6px); transition:opacity var(--t-base) var(--ease), transform var(--t-base) var(--ease)}
.top.back .ttl.on{opacity:1; transform:none}

/* ---------- event page (page-only styles, tokens only); 1:1 from design/pages/event.html ---------- */
/* ---------- hero ---------- */
.ev-hero{padding-top:18px; display:grid; gap:22px; grid-template-areas:"head" "ticket" "facts"}
.ev-head{grid-area:head; min-width:0}
.ev-ticket{grid-area:ticket; min-width:0}
.ev-facts{grid-area:facts; min-width:0}
.ev-eyebrow{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px}
.ev-cat{display:inline-flex; align-items:center; gap:7px; min-height:36px; padding:0 14px 0 11px; border-radius:var(--r-pill); background:var(--chip-dark); color:var(--on-chip-dark); font-size:14px; font-weight:700; white-space:nowrap; box-shadow:inset 0 0 0 1px var(--line)}
.ev-cat .ic{color:var(--ember)}
.ev-share{padding:0 18px 0 16px}
.ev-title{font-size:46px; line-height:.98; letter-spacing:-.055em; font-weight:800; margin:0; text-wrap:balance}
.ev-lead{margin-top:12px; max-width:40ch; font-size:17px; line-height:1.45}

/* ---------- the ticket ---------- */
.ticket .core{position:relative}
.tk-band{position:relative; display:block; height:34px; background:var(--ember); color:var(--on-ember)}
.tk-band > svg{display:block; width:100%; height:100%}
.tk-main{display:grid; grid-template-columns:auto 1fr; gap:18px; align-items:center; padding:18px 18px 12px}
.cal{width:104px; border-radius:20px; overflow:hidden; text-align:center; background:var(--surface); box-shadow:var(--hi), var(--shadow), inset 0 0 0 1px var(--line); transform-origin:50% 0; animation:calIn 900ms var(--ease) 150ms both}
.cal .m{display:block; padding:6px 0 5px; background:var(--ink); color:var(--bg); font-size:14px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; line-height:1.2}
.cal .d{display:block; padding:10px 0 0; font-size:54px; font-weight:800; letter-spacing:-.06em; line-height:1; font-variant-numeric:tabular-nums}
.cal .w{display:block; padding:4px 0 12px; font-size:14px; font-weight:700; color:var(--muted)}
@keyframes calIn{from{transform:perspective(500px) rotateX(-75deg); opacity:0} to{transform:none; opacity:1}}
.when{min-width:0}
.when .k{display:block; font-size:14px; font-weight:700; color:var(--muted)}
.when .v{display:flex; align-items:center; gap:10px; font-size:clamp(30px, 10cqi, 40px); font-weight:800; letter-spacing:-.05em; line-height:1.05; font-variant-numeric:tabular-nums; margin-top:2px}
.when .s{display:block; font-size:16px; font-weight:600; margin-top:6px; line-height:1.35}
.live{position:relative; width:12px; height:12px; border-radius:50%; background:var(--ember); flex:none}
.live::after{content:""; position:absolute; inset:0; border-radius:50%; background:var(--ember); animation:livePulse 1.6s var(--ease) infinite}
@keyframes livePulse{from{transform:scale(1); opacity:.7} to{transform:scale(2.6); opacity:0}}
.seats{display:inline-flex; align-items:center; gap:6px; margin-top:10px; min-height:32px; padding:0 12px 0 9px; border-radius:var(--r-pill); font-size:14px; font-weight:800; color:var(--warn); box-shadow:inset 0 0 0 1.5px currentColor}
.tk-perf{position:relative; height:24px}
.tk-perf::before{content:""; position:absolute; left:22px; right:22px; top:11px; border-top:2px dashed var(--line-strong)}
.tk-perf i{position:absolute; top:0; width:24px; height:24px; border-radius:50%; background:var(--surface-2); box-shadow:inset 0 0 0 1px var(--line)}
.tk-perf i:first-child{left:-12px} .tk-perf i:last-child{right:-12px}
.tk-stub{display:grid; gap:10px; padding:6px 18px 18px}
.ev-note{display:flex; gap:10px; align-items:flex-start; padding:12px 14px; border-radius:18px; background:var(--surface-2); line-height:1.4}
.ev-note .ic{color:var(--warn); margin-top:1px}
.tk-stub .go{min-height:60px}
.tk-stub .go .knob{background:rgba(255,255,255,.2)}

/* ---------- facts ---------- */
.facts{margin:0; padding:4px 18px}
/* dl > div.fact > dt (with the icon) + dd; the icon sits in the left column as before */
.fact{position:relative; min-height:72px; padding:14px 0 14px 58px}
.fact + .fact{border-top:1px solid var(--line)}
.fact .fi{position:absolute; left:0; top:14px; width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2); color:var(--ink)}
.fact dt{font-size:14px; font-weight:700; color:var(--muted); line-height:1.3}
.fact dd{margin:2px 0 0; font-weight:700; font-size:17px; line-height:1.4}
.fact dd .muted{font-weight:600; font-size:16px}
.fact dd .missing{font-weight:600; font-size:16px}
.fact .link{min-height:48px; margin-top:2px}

/* ---------- program timeline ---------- */
.ev-cols{display:grid; gap:56px}
.tl{list-style:none; margin:0; padding:0}
.tl li{position:relative; display:grid; grid-template-columns:62px 22px 1fr; gap:10px; align-items:start; padding-bottom:22px}
.tl li:last-child{padding-bottom:0}
.tl li::before{content:""; position:absolute; left:82px; top:16px; bottom:-6px; width:2px; background:var(--line-strong)}
.tl li:last-child::before{display:none}
.tl .t{font-size:17px; font-weight:800; font-variant-numeric:tabular-nums; line-height:1.4; letter-spacing:-.01em}
.tl .dot{width:14px; height:14px; margin:5px 4px 0; border-radius:50%; background:var(--surface); box-shadow:inset 0 0 0 3px var(--ink); position:relative; z-index:1}
.tl .dot.em{background:var(--ember); box-shadow:inset 0 0 0 3px var(--on-ember)}
.tl .dot.miss{box-shadow:inset 0 0 0 2px var(--line-strong)}
.tl b{display:block; font-size:17px; line-height:1.4}
.tl .sub{display:block; color:var(--muted); line-height:1.4; margin-top:2px}

/* ---------- missing content: the menu of the evening (the photos are the one photo slot of the site) ---------- */
.slot-menu{min-height:120px; display:flex; align-items:center; gap:12px; padding:20px; color:var(--muted)}
.ev-also{margin:18px 0 4px; font-weight:700}
.ev-dish{padding:0 16px}
.ev-mosaic{display:grid; grid-template-columns:1fr 1fr; grid-template-areas:"a a" "b c"; gap:10px}
.ev-mosaic .ph-slot:nth-child(1){grid-area:a; aspect-ratio:16/10}
.ev-mosaic .ph-slot:nth-child(2){grid-area:b; aspect-ratio:1}
.ev-mosaic .ph-slot:nth-child(3){grid-area:c; aspect-ratio:1}

/* ---------- good to know ---------- */
.rules{padding:4px 18px}
.rule{display:grid; grid-template-columns:44px 1fr; gap:14px; padding:16px 0; align-items:start; align-content:start}
.rule + .rule{border-top:1px solid var(--line)}
.rule .ri{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2)}
.rule .ri.ok{color:var(--ok)}
.rule h3{margin:0; font-size:17px; line-height:1.3; letter-spacing:-.01em}
.rule p{margin:4px 0 0; color:var(--muted); line-height:1.45}
.ev-call{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px 12px; margin-top:14px; padding:10px 10px 10px 20px; border-radius:var(--r-core); background:var(--surface-2)}
.ev-call span{font-weight:700}

/* ---------- next evening ---------- */
.nx{display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:center; padding:18px}
.nx .cal{width:80px; animation:none; border-radius:18px}
.nx .cal .m{font-size:14px; padding:4px 0 3px}
.nx .cal .d{font-size:36px; padding-top:6px}
.nx .cal .w{font-size:14px; padding-bottom:8px}
.nx b{display:block; font-size:18px; line-height:1.3; letter-spacing:-.01em}
.nx .missing{display:block; margin-top:4px}
.nx-go{grid-column:1 / -1}

/* ---------- states ---------- */
.ev-state{padding-top:40px}
.ev-state .empty{padding:24px 0 8px}
.ev-state .empty h1{max-width:18ch}
.ev-state .empty p{margin:0; max-width:34ch}
.ev-state .ill{color:var(--danger)}
.ev-state .acts{display:grid; gap:10px; width:100%; max-width:360px; margin-top:8px; justify-content:stretch}
.sk-line{height:18px; border-radius:9px}

/* ---------- sticky action bar ---------- */

/* ---------- sheets ---------- */
.sh-p{margin:2px 0 16px; color:var(--muted)}
.sh-list{display:grid; gap:10px}
.sh-list .pill{justify-content:flex-start; padding:0 20px}
.sh-fine{margin:16px 0 4px; font-size:14px; color:var(--muted)}


/* ---------- desktop ---------- */
@container app (min-width:700px){
  .ev-mosaic{grid-template-columns:repeat(3,1fr); grid-template-areas:"a b c"; gap:16px}
  .ev-mosaic .ph-slot:nth-child(n){aspect-ratio:4/3}
}
@container app (min-width:900px){
  .ev-hero{padding-top:56px; grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr); grid-template-areas:"head ticket" "facts ticket"; grid-template-rows:auto 1fr; gap:36px 64px; align-items:start}
  .ev-title{font-size:84px}
  .ev-lead{font-size:20px; margin-top:20px}
  .ev-eyebrow{margin-bottom:22px}
  .ev-ticket{position:sticky; top:170px}
  .tk-main{padding:26px 26px 20px; gap:22px}
  .cal{width:120px}
  .cal .d{font-size:64px}
  .when .v{font-size:48px}
  .tk-stub{padding:8px 26px 26px}
  .tk-perf::before{left:28px; right:28px}
  .facts{padding:6px 24px}
  .ev-cols{grid-template-columns:1fr 1fr; gap:64px}
  .rules{display:grid; grid-template-columns:repeat(3,1fr); padding:8px}
  .rule{grid-template-columns:1fr; gap:14px; padding:20px 18px}
  .rule + .rule{border-top:0; box-shadow:-1px 0 0 var(--line)}
  .ev-call{width:fit-content; gap:28px; padding:6px 6px 6px 24px; border-radius:var(--r-pill)}
  .nx{grid-template-columns:auto 1fr auto; padding:20px 20px 20px 22px; gap:22px}
  .nx-go{grid-column:auto}
  .ev-state{padding-top:72px}
}
/* server ticket without a date: "Последна / сб / от месеца" */
.cal.nodate .m{letter-spacing:.04em}
.cal.nodate .d{letter-spacing:-.03em}

/* sticky action bar */
.ev-abar{transition:transform var(--t-slow) var(--ease), opacity var(--t-slow) var(--ease)}
.ev-abar.off{transform:translateY(24px); opacity:0; pointer-events:none}
</style>

<script>
  import { SC } from "../../../client/sc.ts";
  {
    const t = document.querySelector<HTMLElement>(".top.back .ttl"), h = document.querySelector("h1.ev-title");
    if (t && h && "IntersectionObserver" in window) new IntersectionObserver((es) => { const en = es[0]; t.classList.toggle("on", !en.isIntersecting && en.boundingClientRect.top < 200); }, { root: null, rootMargin: "-150px 0px 0px 0px" }).observe(h);
  }
  import { model, cta, barHTML, ticketHTML, factsHTML, nextInner, loadingHTML, errorHTML, protoHTML, googleCalUrl, icsText, type EvModel } from "./_event.ts";
  import { eventLd, sofiaToday } from "../_ld.ts";
  import { events } from "../../../lib/events.ts";
  import "sc-icons:share-network"; /* the icons of this module in one group (scripts/icon-groups.mjs) */

  const { esc, ic, url, dateLong, RESTAURANT: R } = SC;
  const main = SC.mount();
  const ORIG = main.innerHTML;
  const root0 = main.querySelector<HTMLElement>("[data-ev]")!;
  const slug = root0.dataset.ev!, pageUrl = root0.dataset.url!;
  /* the date from src/lib/events.ts with today in Sofia (the same data as api.events()) */
  let ev = events(sofiaToday()).find((e) => e.id === slug)!;
  const abar = SC.ov.querySelector<HTMLElement>("[data-abar]")!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="description"]');
  let io: IntersectionObserver | null = null, cur: EvModel | null = null;

  /* preview / demo only: simulated states in the hash (#dnes, #pulno, #zarezhdane ...); never on the real site */
  const demo = () => (SC.preview ? decodeURIComponent((location.hash || "").slice(1)) : "");

  function setBar(on: boolean) {
    abar.classList.toggle("off", !on);
    const fab = SC.ov.querySelector(".aifab"); if (fab) fab.classList.toggle("up", on);
    if (on) { abar.removeAttribute("aria-hidden"); abar.removeAttribute("inert"); } else { abar.setAttribute("aria-hidden", "true"); abar.setAttribute("inert", ""); }
  }
  function watchCta() {
    if (io) { io.disconnect(); io = null; }
    const hc = main.querySelector("[data-hero-cta]");
    if (!("IntersectionObserver" in window) || !hc) return;
    io = new IntersectionObserver((es) => { const x = es[0]; setBar(!x.isIntersecting && x.boundingClientRect.top < (x.rootBounds ? x.rootBounds.top + 150 : 150)); }, { root: null, rootMargin: "-150px 0px 0px 0px" });
    io.observe(hc);
  }
  function setHtml(sel: string, h: string): boolean {
    const el = main.querySelector<HTMLElement>(sel); if (!el || el.innerHTML === h) return false; el.innerHTML = h; return true;
  }

  function render() {
    const st = demo(), proto = SC.preview ? protoHTML(st, SC.demo ? (document.documentElement.dataset.root || "./") + "404.html#/sabitia/nyama-takova/" : url.event("nyama-takova")) : ""; /* the demo has no server 404: the 404 page itself */
    if (st === "zarezhdane" || st === "greshka") {
      if (io) { io.disconnect(); io = null; } setBar(false); cur = null;
      main.innerHTML = (st === "zarezhdane" ? loadingHTML() : errorHTML()) + proto;
      return;
    }
    if (!main.querySelector("[data-ev]")) main.innerHTML = ORIG;
    main.querySelector("[data-proto]")?.remove();
    if (proto) main.insertAdjacentHTML("beforeend", proto);
    paint(true);
    SC.reveal();
  }
  function paint(force = false) {
    if (!main.querySelector("[data-ev]")) return;
    const today = sofiaToday();
    ev = events(today).find((x) => x.id === slug) || ev;
    const e = cur = model(ev, today, SC.minutes(), navigator.onLine !== false, demo());
    const c = cta(e);
    const changed = setHtml("[data-ticket]", ticketHTML(ev, e));
    setHtml("[data-facts]", factsHTML(ev, e));
    setHtml("[data-next]", nextInner(e));
    abar.innerHTML = barHTML(c);
    document.title = e.n + " · " + dateLong(e.date) + " | Siracusa Bar & Grill";
    if (meta) meta.setAttribute("content", e.n + ", " + dateLong(e.date) + " от " + e.time + ", Дружба 2. " + e.text + " Запазете място: " + R.phone + ".");
    const ld = document.getElementById("ev-ld"); if (ld) ld.textContent = JSON.stringify(eventLd(ev, new URL("/", pageUrl).href));
    if (changed || force) { setBar(false); watchCta(); }
  }

  /* ---------- calendar + share ---------- */
  function openCalendar(e: EvModel) {
    const s = SC.sheet({ title: "В календара", html: '<p class="sh-p">Изберете своя календар. Той ще ви напомни за вечерта.</p><div class="sh-list">' +
      '<a class="pill pill-line pill-lg pill-block" href="' + googleCalUrl(e) + '" target="_blank" rel="noopener" data-calg>' + ic("calendar-check", 22) + "Google Календар</a>" +
      '<button class="pill pill-line pill-lg pill-block" type="button" data-ics>' + ic("calendar-dots", 22) + "Apple, Outlook и други</button></div>" +
      '<p class="sh-fine">Записваме: ' + dateLong(e.date) + " · " + e.time + " - " + R.close + ", " + esc(R.name) + ", Дружба 2.</p>" });
    s.el.querySelector("[data-calg]")!.addEventListener("click", () => { setTimeout(s.close, 150); });
    s.el.querySelector("[data-ics]")!.addEventListener("click", () => {
      try {
        const href = URL.createObjectURL(new Blob([icsText(e)], { type: "text/calendar;charset=utf-8" })), a = document.createElement("a");
        a.href = href; a.download = e.id + "-" + e.iso + ".ics"; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(href), 4000);
        s.close(); SC.toast("Готово. Отворете файла, за да влезе в календара.");
      } catch { SC.toast("Не успяхме да създадем файла. Ползвайте Google Календар."); }
    });
  }
  function copyLink(u: string) {
    const ok = () => SC.toast("Връзката е копирана");
    try { navigator.clipboard.writeText(u).then(ok, ok); } catch { ok(); }
  }
  function openShare(e: EvModel) {
    const u = location.href.split("#")[0].split("?")[0];
    const text = e.n + " в Siracusa, " + dateLong(e.date) + " · " + e.time;
    const coarse = typeof matchMedia === "function" && matchMedia("(pointer: coarse)").matches;
    if (navigator.share && coarse) { navigator.share({ title: e.n, text, url: u }).catch(() => { /* cancelled */ }); return; }
    const s = SC.sheet({ title: "Сподели", html: '<p class="sh-p">Поканете приятели за ' + esc(text) + '.</p><div class="sh-list">' +
      '<a class="pill pill-line pill-lg pill-block" href="viber://forward?text=' + encodeURIComponent(text + " " + u) + '">' + ic("chat-circle-dots", 22) + "Изпрати във Viber</a>" +
      '<a class="pill pill-line pill-lg pill-block" href="https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(u) + '" target="_blank" rel="noopener">' + ic("facebook-logo", 22) + "Сподели във Facebook</a>" +
      '<button class="pill pill-line pill-lg pill-block" type="button" data-copy>' + ic("copy", 22) + "Копирай връзката</button></div>" });
    s.el.querySelector("[data-copy]")!.addEventListener("click", () => { copyLink(u); s.close(); });
  }

  main.addEventListener("click", (evt) => {
    const t = (evt.target as Element).closest<HTMLElement>("button"); if (!t) return;
    if (t.hasAttribute("data-retry")) { location.hash = ""; return; }
    if (!cur) return;
    if (t.hasAttribute("data-cal")) openCalendar(cur);
    else if (t.hasAttribute("data-evshare")) openShare(cur);
  });

  window.addEventListener("hashchange", () => { render(); window.scrollTo(0, 0); });
  window.addEventListener("online", () => paint()); window.addEventListener("offline", () => paint());
  document.addEventListener("sc:tick", () => paint());
  render();
</script>
