---
/* Gallery (/galeria/): port of design/pages/gallery.html (design/PAGES.md "gallery.html", design/reviews/gallery.review.md).
   The server draws the hero, the filter chips with counts from the data, every tile of the masonry (real dishes with their
   prices; the hall, the garden and the events as [ЛИПСВА: снимка] slots), the note about the photo shoot, "Елате при нас",
   the viewer's frame and captions (as <template>) and the JSON-LD (BreadcrumbList). The browser lays out the masonry,
   draws the dish illustrations near the viewport (lazy, keeps the HTML light), keeps the filter in the address (#gradina)
   and runs the viewer: "Затвори", arrows, swipe, swipe down to close, Escape, focus trap, focus back, "Назад" closes it.
   Loading and offline exist only in the preview panel (?preview=1): the page has no data to wait for. */
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/routes.ts";
import { ic } from "../../lib/icons.ts";
import { chipsHTML, tilesHTML, lbFrameHTML, dishesJSON, countText, galleryLd, hours } from "./_gallery.ts";

const description = "Галерия на Siracusa Bar & Grill в Дружба 2: ястия от пещта и скарата Bertha, салонът, отоплявана градина и празниците при нас.";
---
<Base page="gallery" nav={null} title="Галерия" description={description} jsonld={galleryLd(Astro.site)}>
  <section class="sec g-hero">
    <div><h1 class="h1">Галерия</h1><p class="lead">Ястията от пещта и скарата Bertha, салонът, отопляваната градина и празниците при нас.</p></div>
    <div class="g-tools">
      <div class="chips g-chips" role="group" aria-label="Покажи" set:html={chipsHTML()}></div>
    </div>
  </section>
  <section class="wrap" aria-label="Снимки" data-gallery>
    <p class="vh" data-count aria-live="polite">{countText("all")}</p>
    <div class="mason" data-mason set:html={tilesHTML()}></div>
    <div data-state></div>
    <p class="g-note"><Fragment set:html={ic("images", 18)} /><span>Новата фотосесия предстои. Дотогава ястията са показани с илюстрации, а за салона, градината и събитията сме запазили място. <span class="missing">[ЛИПСВА: снимки от новата фотосесия]</span></span></p>
  </section>
  <section class="sec visit">
    <div class="shell"><div class="core">
      <div style="display:grid;gap:10px"><h2 class="h2">Елате при нас</h2><p class="lead">Салон и отоплявана градина в Дружба&nbsp;2. Всеки ден от {hours.open} до&nbsp;{hours.close}.</p></div>
      <div class="acts"><a class="pill pill-red pill-lg" href={url.reservation()}><Fragment set:html={ic("calendar-blank", 20)} />Резервирай маса</a><a class="pill pill-line pill-lg" href={url.menu()}><Fragment set:html={ic("fork-knife", 20)} />Към менюто</a></div>
    </div></div>
  </section>
  <span id="g-open" hidden>Отвори на цял екран</span>
  <div data-proto></div>
  <template data-lbframe set:html={lbFrameHTML()}></template>
  <script type="application/json" data-dishes set:html={dishesJSON()}></script>
</Base>

<style is:global>
/* gallery page only (design/pages/gallery.html), tokens from tokens.css */
.g-hero{padding-top:28px}
.g-hero .lead{margin-top:10px; max-width:36ch}
.g-tools{margin-top:22px; display:grid; gap:12px}
.g-chips .chip{min-height:48px}
.g-chips .chip .ic{opacity:.85}
.g-note{margin:28px 0 0; display:flex; gap:10px; align-items:flex-start; padding:12px 14px; border-radius:20px; background:var(--surface); box-shadow:inset 0 0 0 1px var(--line); font-size:14px; color:var(--muted); line-height:1.45}
.g-note .ic{color:var(--ink); margin-top:1px; flex:none}

/* masonry: explicit placement keeps DOM order = reading order. Before the script lays it out: a plain grid. */
.mason{position:relative; display:grid; grid-template-columns:repeat(var(--cols,2), minmax(0,1fr)); row-gap:18px; column-gap:12px; margin-top:18px}
.mason.laid{grid-auto-rows:2px; row-gap:0}
.mason[hidden]{display:none}
.gi{align-self:start; display:grid; gap:10px; width:100%; padding:0; border:0; background:transparent; color:inherit; text-align:left; cursor:zoom-in; border-radius:var(--r-img); font:inherit}
.gi[hidden]{display:none}
.gi:focus-visible{outline-offset:4px}
.tile{position:relative; display:block; aspect-ratio:var(--ar); border-radius:var(--r-img); overflow:hidden; isolation:isolate; transition:transform var(--t-fast) var(--ease)}
.gi:active .tile{transform:scale(.98)}
.gi.feat .tile{aspect-ratio:1.6}
.gi.feat .gcap b{font-size:20px; letter-spacing:-.02em}
.tile .pic{position:absolute; inset:0}
.tile .pic > svg{transition:transform 600ms var(--ease)}
.gcap{display:grid; gap:2px; padding:0 4px; min-width:0}
.gcap b{font-size:16px; line-height:1.25; letter-spacing:-.01em; font-weight:700}
.gcap small{font-size:14px; color:var(--muted); font-weight:600; line-height:1.3}
.gcap .price{color:var(--ink)}

/* empty photo slot: the one photo slot of the site (lib/ui.ts photoSlot), filling the tile */
.tile .g-slot{position:absolute; inset:0; padding:12px; gap:6px}
/* the caption under the tile says what it is: no "Снимка" label inside the small tiles (the viewer keeps it) */
.tile .g-slot .ph-l{display:none}
@media (hover:hover){
  .gi:hover .tile .pic > svg{transform:scale(1.05) rotate(-4deg)}
}

/* skeleton + states */
.g-skel{display:grid; grid-template-columns:repeat(var(--cols,2), minmax(0,1fr)); gap:18px 12px; margin-top:18px; align-items:start}
.skel-it{display:grid; gap:10px; align-self:start}
.skel-it .skel{border-radius:var(--r-img)}
.skel-line{height:14px; border-radius:7px}
.g-state{margin-top:18px}
.g-state .ill{color:var(--ink)}
.g-state .lead{max-width:34ch}

/* visit */
.visit{display:grid; gap:18px}
.visit .core{padding:22px 20px; display:grid; gap:14px}
.visit .acts{display:grid; gap:10px}


/* viewer (lightbox), in the fixed .ov layer */
.lb{position:absolute; inset:0; z-index:70; display:grid; grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(0,1fr) auto; color:var(--on-chip-dark); pointer-events:auto; outline:none}
.lb-bg{position:absolute; inset:0; z-index:-1; background:var(--chip-dark)}
.lb-top{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:14px 12px 6px 20px; padding-top:max(14px, env(safe-area-inset-top))}
.lb-where{display:flex; align-items:center; gap:8px; font-size:15px; font-weight:700; min-width:0}
.lb-where .ic{color:var(--ember)}
.lb-btn{display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:48px; padding:0 18px; border:0; border-radius:999px; font:inherit; font-weight:700; font-size:16px; color:var(--on-chip-dark); background:color-mix(in srgb, var(--on-chip-dark) 12%, transparent); cursor:pointer; text-decoration:none; white-space:nowrap; transition:transform var(--t-fast) var(--ease), opacity var(--t-fast) var(--ease)}
.lb-btn:active{transform:scale(.96)}
.lb-btn[disabled]{opacity:.35; cursor:default; transform:none}
.lb-btn.red{background:var(--red); color:var(--on-red)}
.lb-btn.done{background:var(--ok); color:var(--on-ok)}
.lb :focus-visible{outline-color:var(--ember)}
.lb-stage{position:relative; overflow:hidden; touch-action:pan-y; cursor:grab; user-select:none; -webkit-user-select:none}
.lb-stage.drag{cursor:grabbing}
.lb-track{display:flex; height:100%; will-change:transform}
.lb-slide{flex:0 0 100%; height:100%; padding:8px 16px; display:grid; place-items:center; container-type:size}
.lb-media{position:relative; width:min(100cqw, calc(100cqh * var(--ar))); aspect-ratio:var(--ar); border-radius:24px; overflow:hidden; box-shadow:var(--shadow-lg)}
.lb-media .pic, .lb-media .ph-slot{position:absolute; inset:0}
.lb-media::after{content:""; position:absolute; inset:0; border-radius:inherit; box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--on-chip-dark) 10%, transparent); pointer-events:none}
.lb-media .ph-slot > .ic{width:44px; height:44px}
.lb-bot{display:grid; gap:14px; padding:10px 16px 18px; padding-bottom:max(18px, env(safe-area-inset-bottom))}
.lb-info{display:grid; gap:14px}
.lb-cap{display:grid; gap:4px; min-height:56px}
.lb-cap h2{margin:0; font-size:22px; line-height:1.2; letter-spacing:-.025em; font-weight:800; text-wrap:balance}
.lb-cap p{margin:0; font-size:15px; color:color-mix(in srgb, var(--on-chip-dark) 70%, transparent); font-weight:600}
.lb-cap .missing{color:color-mix(in srgb, var(--on-chip-dark) 70%, transparent)}
.lb-acts{display:grid; grid-template-columns:1fr auto; gap:8px}
.lb-acts .lb-btn{min-height:56px; font-size:17px}
.lb-acts .solo{grid-column:1 / -1}
.lb-nav{display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:8px}
.lb-nav .lb-btn{padding:0 12px; background:transparent; box-shadow:inset 0 0 0 1.5px color-mix(in srgb, var(--on-chip-dark) 28%, transparent)}
.lb-count{margin-left:4px; padding-left:10px; border-left:1.5px solid color-mix(in srgb, var(--on-chip-dark) 25%, transparent); font-size:15px; font-weight:700; font-variant-numeric:tabular-nums; color:color-mix(in srgb, var(--on-chip-dark) 70%, transparent); white-space:nowrap}
.lb-hint{display:block; text-align:center; font-size:14px; color:color-mix(in srgb, var(--on-chip-dark) 60%, transparent); margin-top:-6px}
/* gallery.review 5: the swipe hint only on a touch screen */
@media (hover:hover) and (pointer:fine){ .lb-hint{display:none} }

@container app (min-width:700px){
  .mason, .g-skel{column-gap:16px}
}
@container app (min-width:900px){
  .g-hero{padding-top:56px; display:grid; grid-template-columns:1fr auto; align-items:end; column-gap:40px}
  .g-hero .g-tools{grid-column:1 / -1; margin-top:32px}
  .g-hero .lead{font-size:19px}
  .mason, .g-skel{column-gap:20px; margin-top:24px}
  .visit .core{grid-template-columns:1fr auto; align-items:center; padding:32px 36px}
  .visit .acts{grid-auto-flow:column}
  .lb-top{padding:20px 24px 8px 32px}
  .lb-slide{padding:12px 120px}
  .lb-bot{width:min(820px, 100%); margin:0 auto; padding:16px 24px 80px}
  .lb-info{grid-template-columns:minmax(0,1fr) auto; align-items:center; column-gap:28px}
  .lb-acts{grid-auto-flow:column; grid-template-columns:none}
  .lb-acts .solo{grid-column:auto}
  .lb-nav{position:absolute; inset:50% 24px auto 24px; transform:translateY(-50%); grid-template-columns:auto auto; justify-content:space-between; pointer-events:none}
  .lb-nav .lb-btn{pointer-events:auto; background:color-mix(in srgb, var(--on-chip-dark) 10%, transparent); box-shadow:none}
  .lb-hint{display:none}
}
</style>

<script>
  import { SC } from "../../client/sc.ts";
  import { artSvg } from "../../lib/art.ts";
  import type { Dish } from "../../lib/data.ts";
  import { stateBox as box, loadingText, previewPanel, pvChip, PV } from "../../lib/ui.ts";
  import "../../lib/icons/images.ts";
  import "../../lib/icons/warning-circle.ts";

  type Cat = "all" | "yastia" | "salon" | "gradina" | "sabitia";
  const NAMES: Record<Cat, string> = { all: "Всички", yastia: "Ястия", salon: "Салон", gradina: "Градина", sabitia: "Събития" };
  const main = SC.mount();
  const root = main.querySelector<HTMLElement>("[data-gallery]")!;
  const mason = root.querySelector<HTMLElement>("[data-mason]")!;
  const stateBox = root.querySelector<HTMLElement>("[data-state]")!;
  const countEl = root.querySelector<HTMLElement>("[data-count]")!;
  const tiles = Array.from(mason.querySelectorAll<HTMLButtonElement>(".gi"));
  const DISHES: Record<string, Dish> = JSON.parse(main.querySelector("[data-dishes]")!.textContent || "{}");
  const de = document.documentElement;

  /* ---------- lazy illustrations: drawn ~1 screen before they come into view ---------- */
  function drawArt(el: HTMLElement) { const id = el.dataset.art; if (id && DISHES[id] && !el.querySelector("svg")) el.insertAdjacentHTML("afterbegin", artSvg(DISHES[id])); el.removeAttribute("data-art"); }
  const artIO = "IntersectionObserver" in window ? new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { drawArt(e.target as HTMLElement); artIO!.unobserve(e.target); } }), { rootMargin: "800px 0px" }) : null;
  mason.querySelectorAll<HTMLElement>("[data-art]").forEach((el) => (artIO ? artIO.observe(el) : drawArt(el)));

  /* ---------- filter + masonry ---------- */
  let cur: Cat = "all", state: "ok" | "loading" | "offline" = "ok", items: HTMLButtonElement[] = tiles;
  const isCat = (c: string): c is Cat => c in NAMES;
  const hashCat = (): Cat => { const h = decodeURIComponent((location.hash || "").slice(1)); return isCat(h) ? h : "all"; };
  const listFor = (c: Cat) => (c === "all" ? tiles : tiles.filter((t) => t.dataset.c === c));

  const colsFor = (w: number) => (w < 560 ? 2 : w < 860 ? 3 : 4);
  function layout() { /* shortest-column placement; rows are 2px, so spans follow the real height */
    const w = mason.clientWidth; if (!w || state !== "ok") return;
    const cols = colsFor(w); mason.style.setProperty("--cols", String(cols));
    mason.classList.remove("laid");
    items.forEach((k) => { k.style.gridColumn = ""; k.style.gridRow = ""; });
    items.forEach((k, i) => { const f = i === 0 && cols >= 3; k.classList.toggle("feat", f); if (f) k.style.gridColumn = "1 / span 2"; });
    const gap = cols > 2 ? (w > 900 ? 28 : 22) : 18, heights: number[] = new Array(cols).fill(0);
    const hs = items.map((k) => k.getBoundingClientRect().height); /* read all, then write (one reflow) */
    items.forEach((k, i) => {
      const span = Math.ceil((hs[i] + gap) / 2);
      if (i === 0 && cols >= 3) { k.style.gridColumn = "1 / span 2"; k.style.gridRow = "1 / span " + span; heights[0] = heights[1] = span * 2; return; }
      const col = heights.indexOf(Math.min(...heights));
      k.style.gridColumn = String(col + 1); k.style.gridRow = (heights[col] / 2 + 1) + " / span " + span; heights[col] += span * 2;
    });
    mason.classList.add("laid");
  }

  function countText(c: Cat) {
    const L = listFor(c), nd = L.filter((t) => t.dataset.c === "yastia").length;
    return NAMES[c] + ": " + L.length + " " + (L.length === 1 ? "кадър" : "кадъра") + (c === "all" ? ", " + nd + " ястия и " + (L.length - nd) + " места за снимки" : "");
  }

  function render(animate: boolean) {
    items = listFor(cur);
    main.querySelectorAll<HTMLElement>(".g-chips [data-cat]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.cat === cur)));
    /* the active chip stays in view in the scrolling row (#gradina opens with "Градина" visible) */
    const row = main.querySelector<HTMLElement>(".g-chips")!, on = row.querySelector<HTMLElement>('[aria-pressed="true"]');
    if (on && row.scrollWidth > row.clientWidth) { const l = on.offsetLeft - row.offsetLeft - 16, r = l + on.offsetWidth + 32; if (l < row.scrollLeft || r > row.scrollLeft + row.clientWidth) row.scrollTo({ left: Math.max(0, l), behavior: animate && !SC.reduce ? "smooth" : "auto" }); }
    stateBox.innerHTML = "";
    if (state === "loading") {
      countEl.textContent = loadingText("снимките"); mason.hidden = true;
      const ars = [0.8, 1, 1.25, 1, 1, 0.8, 1.25, 1];
      stateBox.innerHTML = '<div class="g-skel" aria-hidden="true" style="--cols:' + colsFor(mason.parentElement!.clientWidth || 360) + '">' + ars.map((a) => '<div class="skel-it"><span class="skel" style="aspect-ratio:' + a + '"></span><span class="skel skel-line" style="width:70%"></span><span class="skel skel-line" style="width:45%"></span></div>').join("") + "</div>";
      return;
    }
    if (state === "offline") {
      mason.hidden = true; countEl.textContent = "";
      stateBox.innerHTML = box({ kind: "offline", what: "снимките", retry: 'data-sim="ok"', cls: "g-state" });
      return;
    }
    if (!items.length) {
      mason.hidden = true; countEl.textContent = "";
      stateBox.innerHTML = '<div class="empty g-state"><span class="ill">' + SC.ic("images", 44) + '</span><h2 class="h3">Тук още няма снимки</h2><p class="lead">Скоро ще добавим. Междувременно разгледайте останалите.</p><button class="pill pill-red pill-lg" type="button" data-cat="all">Виж всички</button></div>';
      return;
    }
    mason.hidden = false;
    tiles.forEach((t) => { t.hidden = !items.includes(t); });
    countEl.textContent = countText(cur);
    layout();
    if (animate && !SC.reduce) items.forEach((k, i) => k.animate([{ opacity: 0, transform: "translateY(14px) scale(.98)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: Math.min(i, 10) * 28, easing: "cubic-bezier(.32,.72,0,1)", fill: "backwards" }));
  }

  function setCat(c: string, push: boolean) {
    cur = isCat(c) ? c : "all"; state = "ok";
    main.querySelectorAll<HTMLElement>("[data-pv] [data-sim]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sim === "ok")));
    if (push) { try { history.replaceState(history.state, "", cur === "all" ? location.pathname + location.search : "#" + cur); } catch { location.hash = cur === "all" ? "" : cur; } }
    render(true);
  }

  cur = hashCat(); render(false);
  if ("ResizeObserver" in window) { let lastW = 0; new ResizeObserver(() => { const w = mason.clientWidth; if (Math.abs(w - lastW) > 1) { lastW = w; layout(); } }).observe(mason.parentElement!); }
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => layout());
  window.addEventListener("hashchange", () => { const c = hashCat(); if (c !== cur) setCat(c, false); });

  main.addEventListener("click", (e) => {
    const t = e.target as Element;
    const b = t.closest<HTMLElement>("[data-cat]"); if (b) { setCat(b.dataset.cat!, true); return; }
    const s = t.closest<HTMLElement>("[data-sim]");
    if (s) {
      state = s.dataset.sim as typeof state;
      main.querySelectorAll<HTMLElement>("[data-pv] [data-sim]").forEach((x) => x.setAttribute("aria-pressed", String(x.dataset.sim === state)));
      render(state === "ok");
      if (s.closest("[data-pv]")) window.scrollTo({ top: Math.max(0, root.getBoundingClientRect().top + window.scrollY - 150), behavior: SC.reduce ? "auto" : "smooth" });
      return;
    }
    const g = t.closest<HTMLButtonElement>(".gi"); if (g) openLB(items.indexOf(g));
  });

  /* ---------- preview only: the states panel ---------- */
  if (SC.preview) {
    main.querySelector("[data-proto]")!.outerHTML = previewPanel(pvChip(PV.normal, true, 'data-sim="ok"') + pvChip(PV.loading, false, 'data-sim="loading"') + pvChip(PV.offline, false, 'data-sim="offline"'),
      { id: "g-pv", cls: "g-pv", text: "Вижте как изглежда галерията в другите състояния. Тези бутони ги няма на истинския сайт." });
  }

  /* ---------- viewer: "Затвори", arrows, swipe left/right, swipe down to close, keyboard, focus trap ---------- */
  const frameT = main.querySelector<HTMLTemplateElement>("[data-lbframe]")!;
  let lb: HTMLElement | null = null, idx = 0, track!: HTMLElement, stage!: HTMLElement, inerted: HTMLElement[] = [];
  const slide = (k: number) => track.children[k] as HTMLElement | undefined;
  const E = SC.esc;
  /* the slide: the tile's own picture (a clone; the dish illustration is drawn when the slide is near) */
  function slideEl(t: HTMLElement): HTMLElement {
    const s = document.createElement("div"); s.className = "lb-slide"; s.setAttribute("aria-hidden", "true");
    const m = document.createElement("div"); m.className = "lb-media"; m.style.setProperty("--ar", t.querySelector<HTMLElement>(".tile")!.style.getPropertyValue("--ar"));
    const src = t.querySelector<HTMLElement>(".tile > .pic, .tile > .ph-slot")!.cloneNode(true) as HTMLElement;
    const svg = src.querySelector("svg[data-dish]"); if (svg) { svg.remove(); src.dataset.art = t.dataset.id; }
    m.appendChild(src); s.appendChild(m); return s;
  }
  const stock = (n: string) => lb!.querySelector('[data-stock] [data-k="' + n + '"]')!.innerHTML;
  function capHTML(t: HTMLElement): string {
    const d = t.dataset, cat = NAMES[d.c as Cat];
    if (d.id) return '<div class="lb-cap"><h2 id="lbt">' + E(d.t!) + "</h2><p>" + E(d.s!) + " · " + E(d.g!) + "</p></div>" +
      '<div class="lb-acts"><button class="lb-btn red" type="button" data-lbadd="' + d.id + '">' + stock("plus") + '<span>Добави · <span class="price">' + SC.fmt(+d.p!) + '</span></span></button><a class="lb-btn" href="' + d.href + '">За ястието</a></div>';
    return '<div class="lb-cap"><h2 id="lbt">' + E(d.t!) + "</h2><p>" + cat + ' · <span class="missing">[ЛИПСВА: снимка от новата фотосесия]</span></p></div>' +
      '<div class="lb-acts"><a class="lb-btn red solo" href="' + d.href + '">' + stock(d.goi!) + E(d.go!) + "</a></div>";
  }

  function openLB(i: number) {
    if (lb || i < 0) return; idx = i;
    lb = document.createElement("div"); lb.className = "lb"; lb.setAttribute("role", "dialog"); lb.setAttribute("aria-modal", "true"); lb.setAttribute("aria-labelledby", "lbt"); lb.tabIndex = -1;
    lb.appendChild(frameT.content.cloneNode(true));
    track = lb.querySelector<HTMLElement>("[data-track]")!; stage = lb.querySelector<HTMLElement>("[data-stage]")!;
    items.forEach((t) => track.appendChild(slideEl(t)));
    SC.ov.appendChild(lb);
    /* everything behind the viewer is inert (screen readers and Tab stay inside) and the page does not scroll */
    inerted = [SC.device, ...Array.from(document.querySelectorAll<HTMLElement>("[data-ov-ck]")), ...(Array.from(SC.ov.children) as HTMLElement[])].filter((el) => el !== lb && !el.inert);
    inerted.forEach((el) => (el.inert = true));
    de.classList.add("sheet-open");
    go(idx, false);
    try { history.pushState({ lb: 1 }, "", location.href); } catch { /* ignore */ }
    lb.addEventListener("click", onLBClick); lb.addEventListener("keydown", onKey);
    stage.addEventListener("pointerdown", onDown);
    lb.querySelector<HTMLElement>("[data-lbclose]")!.focus({ preventScroll: true });
    zoom(true);
  }
  function closeLB(fromPop?: boolean) {
    if (!lb) return; const el = lb, t = items[idx];
    de.classList.remove("sheet-open");
    if (t) { const r = t.getBoundingClientRect(); if (r.top < 90 || r.bottom > window.innerHeight - 90) t.scrollIntoView({ block: "center" }); }
    inerted.forEach((x) => (x.inert = false)); inerted = [];
    zoom(false, () => el.remove());
    el.inert = true; lb = null;
    t && t.focus({ preventScroll: true });
    if (!fromPop) { try { if (history.state && history.state.lb) history.back(); } catch { /* ignore */ } }
  }
  window.addEventListener("popstate", () => { if (lb) closeLB(true); });

  /* the one strong movement on the page: the tile grows into the viewer, and shrinks back on close */
  function zoom(opening: boolean, done?: () => void) {
    const el = (lb || track.closest(".lb")) as HTMLElement, bg = el.querySelector<HTMLElement>(".lb-bg")!, chrome = el.querySelectorAll<HTMLElement>(".lb-top,.lb-bot");
    const m = slide(idx)?.querySelector<HTMLElement>(".lb-media"), t = items[idx]?.querySelector<HTMLElement>(".tile");
    const D = 420, ease = "cubic-bezier(.32,.72,0,1)";
    if (SC.reduce || !m) { if (!opening) { el.style.opacity = "0"; setTimeout(() => done && done(), 10); } return; }
    const a = m.getBoundingClientRect(), b = t ? t.getBoundingClientRect() : null;
    const from = b && b.width && a.width ? "translate(" + (b.left - a.left + (b.width - a.width) / 2) + "px," + (b.top - a.top + (b.height - a.height) / 2) + "px) scale(" + b.width / a.width + ")" : "translateY(24px) scale(.94)";
    /* closing uses implicit start keyframes, so a half-done swipe-down continues smoothly from where the finger left it */
    const kf = opening ? [{ transform: from, borderRadius: "22px" }, { transform: "none", borderRadius: "24px" }] : [{ transform: from, borderRadius: "22px" }];
    const anims: Animation[] = [], anim = m.animate(kf, { duration: D, easing: ease, fill: "both" }); anims.push(anim);
    anims.push(bg.animate(opening ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 0 }], { duration: opening ? 300 : 360, easing: "ease-out", fill: "both" }));
    chrome.forEach((c) => anims.push(c.animate(opening ? [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }] : [{ opacity: 0 }], { duration: opening ? 360 : 200, delay: opening ? 120 : 0, easing: ease, fill: "both" })));
    /* once open, drop the filled animations so the swipe-down gesture can move the photo with inline styles */
    if (opening) Promise.all(anims.map((x) => x.finished)).then(() => anims.forEach((x) => x.cancel())).catch(() => {});
    else { const hide = t && (t.closest(".gi") as HTMLElement); if (hide) hide.style.opacity = "0"; anim.onfinish = () => { if (hide) hide.style.opacity = ""; done && done(); }; }
  }

  function go(i: number, animate?: boolean) {
    if (!lb) return;
    idx = Math.max(0, Math.min(items.length - 1, i));
    const t = items[idx], chipIc = main.querySelector('.g-chips [data-cat="' + t.dataset.c + '"] svg');
    track.style.transition = animate === false || SC.reduce ? "none" : "transform var(--t-slow) var(--ease)";
    track.style.transform = "translate3d(" + -idx * 100 + "%,0,0)";
    Array.from(track.children).forEach((s, k) => s.setAttribute("aria-hidden", String(k !== idx)));
    /* draw the illustration of this photo and its neighbours */
    [idx - 1, idx, idx + 1].forEach((k) => { const p = slide(k)?.querySelector<HTMLElement>("[data-art]"); if (p) drawArt(p); });
    lb.querySelector("[data-where]")!.innerHTML = (chipIc ? chipIc.outerHTML : "") + "<span>" + NAMES[t.dataset.c as Cat] + '</span><span class="lb-count">' + (idx + 1) + " от " + items.length + "</span>";
    lb.querySelector("[data-info]")!.innerHTML = capHTML(t);
    lb.querySelector<HTMLButtonElement>("[data-prev]")!.disabled = idx === 0;
    lb.querySelector<HTMLButtonElement>("[data-next]")!.disabled = idx === items.length - 1;
    lb.querySelector("[data-live]")!.textContent = idx + 1 + " от " + items.length + ": " + (t.dataset.t || "");
    /* a disabled button cannot hold the focus: keep it in the viewer */
    if (document.activeElement instanceof HTMLButtonElement && document.activeElement.disabled) lb.querySelector<HTMLButtonElement>(idx === 0 ? "[data-next]" : "[data-prev]")!.focus();
  }
  function onLBClick(e: MouseEvent) {
    const b = (e.target as Element).closest<HTMLElement>("button, a"); if (!b) return;
    if (b.hasAttribute("data-lbclose")) return closeLB();
    if (b.hasAttribute("data-prev")) return go(idx - 1);
    if (b.hasAttribute("data-next")) return go(idx + 1);
    if (b.dataset.lbadd) {
      const t = items[idx]; SC.cart.add(b.dataset.lbadd, 1, { p: +t.dataset.p!, n: t.dataset.t });
      SC.haptic(); SC.flash(b as HTMLButtonElement, SC.ic("check", 20) + "Добавено", 1400); SC.toast("Добавено ✓");
    }
  }
  function onKey(e: KeyboardEvent) {
    if (!lb) return;
    if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); closeLB(); }
    else if (e.key === "ArrowRight") { e.preventDefault(); go(idx + 1); }
    else if (e.key === "ArrowLeft") { e.preventDefault(); go(idx - 1); }
    else if (e.key === "Tab") {
      const f = Array.from(lb.querySelectorAll<HTMLElement>("button:not([disabled]), a[href]")).filter((x) => x.offsetParent !== null);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (!lb.contains(document.activeElement)) { e.preventDefault(); first.focus(); }
      else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }
  /* swipe: horizontal changes the photo (rubber band at the ends), vertical down closes */
  let sx = 0, sy = 0, st = 0, dir: "x" | "y" | null = null, dx = 0, dy = 0;
  function onDown(e: PointerEvent) {
    if (e.button) return; sx = e.clientX; sy = e.clientY; st = performance.now(); dir = null; dx = dy = 0;
    stage.setPointerCapture(e.pointerId); stage.addEventListener("pointermove", onMove); stage.addEventListener("pointerup", onUp); stage.addEventListener("pointercancel", onUp);
  }
  function onMove(e: PointerEvent) {
    if (!lb) return;
    dx = e.clientX - sx; dy = e.clientY - sy;
    if (!dir) { if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) dir = "x"; else if (dy > 8 && dy > Math.abs(dx)) dir = "y"; else return; stage.classList.add("drag"); track.style.transition = "none"; }
    if (dir === "x") { const edge = (idx === 0 && dx > 0) || (idx === items.length - 1 && dx < 0); track.style.transform = "translate3d(calc(" + -idx * 100 + "% + " + (edge ? dx / 3 : dx) + "px),0,0)"; }
    else {
      const m = slide(idx)!.querySelector<HTMLElement>(".lb-media")!, k = Math.max(0, dy);
      m.style.transform = "translateY(" + k + "px) scale(" + (1 - Math.min(k, 400) / 1600) + ")";
      lb.querySelector<HTMLElement>(".lb-bg")!.style.opacity = String(1 - Math.min(k, 300) / 450);
      lb.querySelectorAll<HTMLElement>(".lb-top,.lb-bot").forEach((c) => (c.style.opacity = String(Math.max(0, 1 - k / 140))));
    }
  }
  function onUp() {
    stage.removeEventListener("pointermove", onMove); stage.removeEventListener("pointerup", onUp); stage.removeEventListener("pointercancel", onUp); stage.classList.remove("drag");
    if (!lb) return;
    const v = Math.abs(dx) / Math.max(1, performance.now() - st);
    if (dir === "x") { if ((dx < -60 || (dx < -20 && v > 0.5)) && idx < items.length - 1) go(idx + 1); else if ((dx > 60 || (dx > 20 && v > 0.5)) && idx > 0) go(idx - 1); else go(idx); }
    else if (dir === "y") {
      const m = slide(idx)!.querySelector<HTMLElement>(".lb-media")!, bg = lb.querySelector<HTMLElement>(".lb-bg")!;
      if (dy > 110) closeLB();
      else { lb.querySelectorAll<HTMLElement>(".lb-top,.lb-bot").forEach((c) => (c.style.opacity = "")); m.style.transition = "transform var(--t-slow) var(--ease)"; m.style.transform = ""; bg.style.opacity = ""; setTimeout(() => (m.style.transition = ""), 340); }
    }
    dir = null;
  }

  root.dataset.ready = "1";
  SC.reveal();
</script>
