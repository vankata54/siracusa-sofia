---
/* Общи условия (/obshti-uslovia/): simple text template (docs/BUILD-PLAN.md, legal pages).
   Facts only from the code and the decisions: RESTAURANT (hours, kitchen, delivery, payment, contacts), ZONES,
   prices in euro with VAT (footer), lunch menu after 15:00 only for pickup with -30%, the one-time -10% code
   (decision 12.11.2026), "Изчерпано днес", preliminary allergens. Legal wording: "[ЛИПСВА: текст от юрист]". */
import Legal from "../poveritelnost/_Legal.astro";
import { url, esc, ZONES, RESTAURANT as R } from "../../lib/index.ts";
import { payAnswer } from "../../lib/pay.ts";
import { MP, contactsHTML, type LegalSection } from "../poveritelnost/_legal.ts";

const join = (a: string[]) => (a.length < 2 ? a.join("") : a.slice(0, -1).join(", ") + " и " + a[a.length - 1]);
const free = ZONES.filter((z) => z.free).map((z) => z.n), paid = ZONES.filter((z) => !z.free).map((z) => z.n);
const sections: LegalSection[] = [
  { id: "targovets", h: "Търговец", html: contactsHTML() + MP("текст от юрист: данни на търговеца по Закона за защита на потребителите и Закона за електронната търговия") },
  { id: "predmet", h: "За какво се отнасят условията", html: MP("текст от юрист: предмет, приемане на условията, определения") },
  {
    id: "porachki", h: "Поръчки",
    html: "<p>Поръчвате от <a href=\"" + url.menu() + "\">менюто</a> през количката или по телефона <a href=\"tel:" + R.phoneIntl + "\">" + R.phone + "</a>. " +
      "След поръчката получавате номер и страница за проследяване.</p><p>Ястие, което е свършило за деня, остава в менюто с надпис „Изчерпано днес“ и не може да се поръча.</p>" +
      MP("текст от юрист: кога се сключва договорът, потвърждение и отказ на поръчка от ресторанта"),
  },
  {
    id: "chasove", h: "Работно време, доставка и вземане",
    html: "<ul><li>Всеки ден от " + R.open + " до " + R.close + ".</li><li>Кухнята приема поръчки до " + R.kitchen + ".</li><li>Доставка до " + R.delivery + ". Вземане от ресторанта до " + R.kitchen + ".</li>" +
      "<li>Безплатна доставка: " + esc(join(free)) + ". Платена доставка: " + esc(join(paid)) + ', такса <span class="missing">[ЛИПСВА: такса в €]</span>.</li>' +
      "<li>Адрес за вземане: " + esc(R.address) + ".</li></ul>" +
      '<p>Подробно: <a href="' + url.page("delivery") + '">Доставка</a> и <a href="' + url.page("pickup") + '">Вземи от място</a>.</p>' +
      MP("текст от юрист: срокове, закъснение, неуспешна доставка"),
  },
  {
    id: "tseni", h: "Цени и плащане",
    html: "<p>Цените в менюто са в евро с ДДС.</p><p>Начини на плащане: " + payAnswer() + "</p>" +
      MP("текст от юрист: касов документ, промяна на цените, кога се дължи плащането"),
  },
  {
    id: "otstapki", h: "Отстъпки",
    html: "<ul><li><b><a href=\"" + url.lunch() + "\">Обедно меню</a></b>: след " + R.lunchUntil + " е само за вземане, с отстъпка -30%.</li>" +
      "<li><b>Код за отстъпка</b> от оценката след поръчка: еднократен, -10% върху ястията (не върху таксата за доставка). Не се комбинира с други отстъпки; при обедното меню важи по-изгодната за вас.</li>" +
      '<li>Всички текущи предложения: <a href="' + url.offers() + '">Оферти</a>.</li></ul>' +
      MP("текст от юрист: условия на офертите и ваучерите"),
  },
  {
    id: "rezervatsii", h: "Резервации и празници",
    html: '<p>Маса резервирате на страницата <a href="' + url.reservation() + '">Резервирай маса</a>, а празник при нас през <a href="' + url.page("celebration") + '">запитване</a>.</p>' +
      MP("текст от юрист: потвърждение, закъснение, отказ от резервация"),
  },
  {
    id: "alergeni", h: "Алергени",
    html: '<p>Алергените на сайта са предварителни, извлечени от състава на ястията; кухнята ги потвърждава. Ако имате алергия, обадете ни се на <a href="tel:' + R.phoneIntl + '">' + R.phone + '</a> преди поръчката. Таблица: <a href="' + url.page("allergens") + '">Алергени</a>.</p>' +
      MP("текст от юрист: отговорност и информация за храните (Регламент (ЕС) 1169/2011)"),
  },
  { id: "reklamatsii", h: "Рекламации и право на отказ", html: MP("текст от юрист: рекламации, право на отказ при храни, срокове и начин на подаване") },
  { id: "danni", h: "Лични данни", html: '<p>Как използваме данните от поръчките и формите: <a href="' + url.page("privacy") + '">Поверителност</a> и <a href="' + url.page("cookies") + '">Бисквитки</a>.</p>' },
  { id: "promeni", h: "Промени и спорове", html: MP("текст от юрист: промени в условията, приложимо право, решаване на спорове (вкл. платформата за онлайн решаване на спорове)") },
];
---
<Legal k="terms" name="Общи условия" docTitle="Общи условия за поръчки и резервации" sections={sections}
  description={"Общите условия за поръчки, доставка, вземане и резервации в " + R.name + ", Дружба 2, София."}
  lead="Условията за поръчки, доставка, вземане и резервации в Siracusa Bar &amp; Grill." />
