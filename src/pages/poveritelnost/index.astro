---
/* Поверителност (/poveritelnost/): simple text template (docs/BUILD-PLAN.md, legal pages).
   Facts only from the code: who we are (RESTAURANT), which forms take which data (src/core/types.ts),
   the marketing consent is always unticked (decision 31), the profile can export and delete its data (api.auth).
   Every place for legal wording is "[ЛИПСВА: текст от юрист]". */
import Legal from "./_Legal.astro";
import { url, RESTAURANT as R } from "../../lib/index.ts";
import { M, MP, contactsHTML, type LegalSection } from "./_legal.ts";

const li = (a: string[]) => "<ul>" + a.map((x) => "<li>" + x + "</li>").join("") + "</ul>";
const sections: LegalSection[] = [
  { id: "koi", h: "Кой обработва данните", html: "<p>Данните, които оставяте на сайта, получава ресторантът:</p>" + contactsHTML() + MP("текст от юрист: администратор на лични данни и длъжностно лице по защита на данните, ако има") },
  {
    id: "kakvi", h: "Какви данни въвеждате на сайта",
    html: "<p>Сайтът иска данни само във формите, които попълвате сами:</p>" + li([
      '<b><a href="' + url.cart() + '">Поръчка</a></b>: име, телефон, адрес за доставка, бележка по желание, начин на плащане; имейл по желание.',
      '<b><a href="' + url.reservation() + '">Резервация</a></b>: име, телефон, дата, час, брой хора; имейл, повод и бележка по желание.',
      '<b><a href="' + url.page("celebration") + '">Празник при нас</a></b>: име, телефон, вид на празника, брой гости, дата; имейл и бележка по желание.',
      '<b><a href="' + url.page("office") + '">Обща поръчка за офиса</a></b>: име на офиса, адрес; имената на колегите в общата поръчка; име и телефон на организатора.',
      '<b><a href="' + url.login() + '">Профил</a></b>: телефон (вход с SMS код), име; по желание имейл, адреси, любими ястия и рожден ден.',
      '<b>Оценка след поръчка</b>: отговор „Да“ или „Не“ и текст по желание; пази се с номера на поръчката.',
      '<b><a href="' + url.page("contacts") + '">Обратна връзка</a></b>: име, телефон или имейл, съобщение.',
    ]) + MP("текст от юрист: цел и правно основание за всяка от формите"),
  },
  {
    id: "marketing", h: "Маркетингови съобщения",
    html: "<p>Отметката за маркетингови предложения във формите е <b>винаги неотметната</b>. Получавате такива съобщения само ако я отметнете сами.</p>" + MP("текст от юрист: какви съобщения, как се оттегля съгласието"),
  },
  { id: "srok", h: "Колко време пазим данните", html: MP("текст от юрист: срокове за поръчки, резервации, профили и обратна връзка") },
  { id: "poluchateli", h: "Кой друг получава данните", html: "<p>" + M("текст от юрист: получатели и обработващи (хостинг, SMS доставчик и др.)") + "</p>" + "<p>Картата от Google Maps на страниците <a href=\"" + url.home() + "\">Начало</a> и <a href=\"" + url.page("contacts") + "\">Контакти</a> се зарежда само когато натиснете бутона за картата.</p>" },
  {
    id: "prava", h: "Вашите права",
    html: "<p>Ако имате профил, в него можете сами да изтеглите данните си („Изтегли данните ми“) и да изтриете профила („Изтрий профила“).</p>" + MP("текст от юрист: права по GDPR и как се упражняват") +
      "<p>За въпроси за данните си пишете на <a href=\"mailto:" + R.email + "\">" + R.email + "</a> или се обадете на <a href=\"tel:" + R.phoneIntl + "\">" + R.phone + "</a>.</p>",
  },
  { id: "kzld", h: "Жалби", html: MP("текст от юрист: право на жалба до Комисията за защита на личните данни") },
  { id: "biskvitki", h: "Бисквитки", html: '<p>Какво пази сайтът в браузъра ви и как да промените избора си: <a href="' + url.page("cookies") + '">Бисквитки</a>.</p>' },
];
---
<Legal k="privacy" name="Поверителност" docTitle="Поверителност и лични данни" sections={sections}
  description={"Как " + R.name + " обработва данните от поръчки, резервации, профил и обратна връзка на сайта. Контакт: " + R.email + "."}
  lead="Кои данни оставяте на сайта на Siracusa, за какво са и как да ги управлявате." />
