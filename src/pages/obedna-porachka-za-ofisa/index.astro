---
/* Обща поръчка за офиса (/obedna-porachka-za-ofisa/): port of design/pages/office.html (design/PAGES.md "office.html",
   BRIEF 8: „Обща поръчка за офиса“ / „Започни обща поръчка“, OPEN-QUESTIONS 17).
   The server draws what does not depend on the hour or the visitor (hero, "Как работи", subscription, FAQ, JSON-LD).
   ./_office.ts draws the create form (time slots depend on the hour) and the views in the address hash:
   #share (link for colleagues), #list (shared list), #mine, #join-<код> (invited colleague), #sent.
   Everything goes through api.office.create/get/join/submit (server, or the core in the browser in the demo). */
import Base from "../../layouts/Base.astro";
import { heroHTML, howHTML, subFaqHTML, officeLd, officeData } from "./_views.ts";

const site = (Astro.site || new URL("https://siracusa-sofia.com")).href;
const sk = (w: string, h: number, r = 14) => `<span class="skel" style="display:block;width:${w};height:${h}px;border-radius:${r}px"></span>`;
const formSkeleton =
  `<div class="o-lay"><div class="o-col"><div><h2 class="h2" id="o-create-h" style="margin-bottom:14px">Отворете поръчка</h2>` +
  `<div class="o-step"><div class="stepper" style="--n:3"><div class="t"><b>Стъпка 1 от 3</b><span>Следва: Споделете</span></div><div class="bar"><span class="on"></span><span></span><span></span></div></div></div></div>` +
  `<div class="o-form" aria-busy="true">${sk("100%", 56)}${sk("100%", 56)}${sk("100%", 56)}${sk("100%", 112)}${sk("100%", 160)}</div></div>` +
  `<aside class="o-aside o-onlydesk">${sk("100%", 320, 28)}</aside></div>`;
---
<Base page="office" nav={null} title="Обща поръчка за офиса"
  description="Обща поръчка за офиса от Siracusa в Дружба 2: един отваря поръчката, праща връзката в чата и всеки си избира от обедното меню до крайния час. Плаща един или всеки сам."
  jsonld={officeLd(Astro.site)}>
  <div data-start>
    <Fragment set:html={heroHTML(site)} />
    <Fragment set:html={howHTML()} />
    <section class="sec" id="o-create" aria-labelledby="o-create-h" data-create><Fragment set:html={formSkeleton} /></section>
    <noscript><p class="sec lead">За общата поръчка през сайта е нужен JavaScript. Можете да поръчате и по телефона: <a href="tel:+359894365577">0894 36 55 77</a>.</p></noscript>
    <Fragment set:html={subFaqHTML()} />
  </div>
  <div data-view hidden></div>
  <script type="application/json" id="o-data" set:html={JSON.stringify(officeData()).replace(/</g, "\\u003c")}></script>
  <div data-proto></div>
</Base>

<style is:global>
/* office: group lunch order. Page-only styles, tokens only. Prefix: o- (1:1 from design/pages/office.html) */
.o-top{padding-top:28px}
.o-eyebrow{display:inline-flex; align-items:center; gap:8px; min-height:36px; padding:0 14px 0 10px; border-radius:999px; background:var(--surface); box-shadow:inset 0 0 0 1px var(--line); font-weight:700; font-size:14px}
.o-eyebrow .ic{color:var(--muted)}
.o-sub{margin-top:10px}
.o-back{margin:-6px 0 6px; gap:8px; min-height:48px}
.o-ava{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; flex:none; font-weight:800; font-size:17px; letter-spacing:-.02em; background:var(--surface-3); color:var(--ink)}
.o-ava.a1{background:var(--chip-dark); color:var(--on-chip-dark); box-shadow:inset 0 0 0 1.5px var(--line)}
.o-ava.a2{background:transparent; box-shadow:inset 0 0 0 1.5px var(--line-strong)}
.o-ava.a3{background:var(--surface-2); box-shadow:inset 0 0 0 1.5px var(--line)}
.o-ava.me{background:var(--ink); color:var(--bg)}
.o-avas{display:flex}
.o-avas .o-ava{width:34px; height:34px; font-size:14px; box-shadow:0 0 0 2.5px var(--surface)}
.o-avas .o-ava.a2{background:var(--surface); box-shadow:0 0 0 2.5px var(--surface), inset 0 0 0 1.5px var(--line-strong)}
.o-avas .o-ava + .o-ava{margin-left:-9px}
.o-card{padding:20px}
.o-note{display:flex; gap:10px; align-items:flex-start; padding:14px 16px; border-radius:var(--r-field); background:var(--surface-2); font-size:15px; font-weight:600; line-height:1.4}
.o-note .ic{margin-top:1px; flex:none}
.o-note.ok .ic{color:var(--ok)} .o-note.warn .ic{color:var(--warn)} .o-note.bad{color:var(--danger)} .o-note.bad .ic{color:var(--danger)}
.o-note .pill{margin-top:10px}
.o-note p{margin:0}
.o-note .link{margin-top:4px; color:var(--danger-ink)} /* 4,5:1 on surface-2 (the red is 4,36:1 there) */
.o-h3{font-size:20px; line-height:1.2; letter-spacing:-.02em; font-weight:800; margin:0}
.o-kv{display:grid; gap:0}
.o-kv .kv{align-items:baseline; padding:11px 0}
.o-kv .kv > span:first-child{color:var(--muted); font-weight:600}
.o-kv .kv > b{text-align:right; font-weight:700}
.o-tot{display:flex; justify-content:space-between; align-items:baseline; gap:12px; padding-top:14px; margin-top:4px; border-top:1.5px solid var(--ink)}
.o-tot b{font-size:18px}
.o-tot .price{font-size:26px; letter-spacing:-.03em}
.o-actions{display:grid; gap:10px}
.o-two{display:grid; grid-template-columns:1fr 1fr; gap:8px}
.o-two .pill{padding:0 12px}
.o-onlydesk{display:none}
.o-lay{display:grid; grid-template-columns:minmax(0,1fr); gap:20px; align-items:start}
.o-col{display:grid; grid-template-columns:minmax(0,1fr); gap:20px; min-width:0}
.o-col > *{min-width:0}
@container app (min-width:900px){
  .o-top{padding-top:40px}
  .o-lay{grid-template-columns:minmax(0,1fr) 400px; gap:48px}
  .o-aside{position:sticky; top:156px}
  .o-onlydesk{display:block}
  .o-onlyphone{display:none}
}

/* ---------- step indicator ---------- */
.o-step{display:grid; gap:10px; margin:0 0 22px; max-width:560px}
.o-step-l{list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:6px; font-size:14px; font-weight:700; color:var(--muted)}
.o-step-l li{display:flex; align-items:center; gap:4px; min-width:0}
.o-step-l li.cur{color:var(--ink)}
.o-step-l li.done .ic{color:var(--ok)}

/* ---------- hero ---------- */
.o-hero{padding-top:28px}
.o-hero .h1{margin-top:18px; max-width:15ch}
.o-hero .lead{margin-top:14px; max-width:34ch}
.o-facts{list-style:none; margin:22px 0 0; padding:0; display:grid; gap:12px}
.o-facts li{display:grid; grid-template-columns:44px 1fr; gap:12px; align-items:center; font-weight:600; line-height:1.35}
.o-fi{width:44px; height:44px; border-radius:50%; display:grid; place-items:center; background:var(--surface); box-shadow:inset 0 0 0 1px var(--line)}
.o-cta{margin-top:26px; display:grid; gap:6px; max-width:420px}
.o-cta .link{justify-self:center; white-space:nowrap; min-height:48px}
.o-hero-grid{display:grid; grid-template-columns:minmax(0,1fr); gap:36px}
.o-hero-grid > *{min-width:0}
.o-demo{max-width:440px; width:100%; justify-self:center}
.o-demo .core{padding:18px 18px 8px}
.o-demo-h{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px}
.o-demo-h b{font-size:16px}
.o-demo-h .small{display:block; color:var(--muted); font-weight:600}
.o-bubble{background:var(--surface-2); border-radius:22px 22px 22px 8px; padding:13px 16px 14px; font-weight:600; line-height:1.4}
.o-bubble .who{display:block; font-size:14px; font-weight:800; margin-bottom:2px}
.o-linkchip{display:inline-flex; align-items:center; gap:6px; margin-top:10px; padding:7px 12px 7px 10px; border-radius:999px; background:var(--surface); font-size:14px; font-weight:700; max-width:100%; box-shadow:inset 0 0 0 1px var(--line)}
.o-linkchip > span{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.o-joins{margin-top:6px}
.o-join{display:grid; grid-template-columns:40px 1fr 56px; gap:12px; align-items:center; padding:12px 0}
.o-join + .o-join{border-top:1px solid var(--line)}
.o-join .o-ava{width:40px; height:40px; font-size:16px}
.o-join .t{min-width:0; line-height:1.3}
.o-join .t b{display:block; font-size:15px}
.o-join .t span{display:block; font-size:14px; color:var(--muted); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.o-join .pic{width:56px; height:56px; border-radius:16px}
.o-demo-f{display:flex; justify-content:space-between; align-items:center; gap:10px; padding:12px 4px 4px; font-weight:700; font-size:15px}
@keyframes oIn{from{opacity:0; transform:translateY(16px) scale(.98)} to{opacity:1; transform:none}}
.o-demo .o-join, .o-demo .o-demo-f{animation:oIn 560ms var(--ease) both}
@media (prefers-reduced-motion: reduce){ .o-demo .o-join, .o-demo .o-demo-f, .o-person.new{animation:none} }
@container app (min-width:900px){
  .o-hero{padding-top:56px}
  .o-hero-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr); gap:64px; align-items:center}
  .o-hero .h1{font-size:60px}
  .o-hero .lead{font-size:19px}
  .o-facts{grid-template-columns:repeat(3,1fr); gap:16px}
  .o-facts li{grid-template-columns:1fr; align-items:start; align-content:start; font-size:15px; gap:10px}
  .o-cta{grid-template-columns:auto auto; justify-content:start; align-items:center; gap:18px; max-width:none}
  .o-cta .go{width:auto; min-width:340px}
  .o-demo{justify-self:end}
}

/* ---------- how it works ---------- */
.o-how{list-style:none; margin:0; padding:0; display:grid}
.o-how li{position:relative; display:grid; grid-template-columns:48px 1fr; gap:16px; padding-bottom:28px}
.o-how li:last-child{padding-bottom:0}
.o-how li:not(:last-child)::before{content:""; position:absolute; left:23px; top:56px; bottom:8px; width:2px; border-radius:1px; background:var(--line-strong)}
.o-num{width:48px; height:48px; border-radius:50%; display:grid; place-items:center; background:var(--ink); color:var(--bg); font-weight:800; font-size:19px; font-variant-numeric:tabular-nums}
.o-how h3{margin:10px 0 4px}
.o-how p{margin:0; color:var(--muted)}
@container app (min-width:900px){
  .o-how{grid-template-columns:repeat(3,1fr); gap:20px}
  .o-how li{grid-template-columns:1fr; padding:26px; border-radius:var(--r-core); background:var(--surface); box-shadow:var(--hi), var(--shadow); gap:6px}
  .o-how li:not(:last-child)::before{display:none}
  .o-how h3{margin-top:16px}
}

/* ---------- create form ---------- */
.o-form{display:grid; gap:26px}
.o-form .field{gap:8px}
.o-form .label{display:block}
.o-quick{display:flex; flex-wrap:wrap; gap:8px}
.o-quick .chip{min-height:48px; font-size:15px}
.o-quick-l{font-size:14px; font-weight:700; color:var(--muted); margin:2px 0 0}
.o-slots{display:grid; grid-template-columns:repeat(4,1fr); gap:8px}
.o-slot{min-height:52px; border:0; border-radius:999px; background:var(--surface); color:var(--ink); box-shadow:inset 0 0 0 1.5px var(--line-strong); font-weight:800; font-size:16px; font-variant-numeric:tabular-nums; cursor:pointer; transition:transform var(--t-fast) var(--ease)}
.o-slot:active{transform:scale(.96)}
.o-slot[aria-pressed="true"]{background:var(--ink); color:var(--bg); box-shadow:none}
.o-slot[disabled]{background:transparent; color:var(--muted); box-shadow:inset 0 0 0 1px var(--line); cursor:not-allowed; text-decoration:line-through; text-decoration-thickness:1.5px}
.o-slot .vh{position:absolute}
.o-res{display:flex; gap:10px; align-items:center; font-weight:700; font-size:15px; margin-top:2px}
.o-res .ic{color:var(--ok)}
.o-choice{border:0; margin:0; padding:0; display:grid; gap:10px}
.o-choice legend{padding:0; margin-bottom:8px}
.o-opt{position:relative; display:grid; grid-template-columns:44px 1fr 26px; gap:14px; align-items:center; min-height:76px; padding:14px 16px; border-radius:var(--r-core); background:var(--surface); box-shadow:inset 0 0 0 1.5px var(--line-strong); cursor:pointer; transition:transform var(--t-fast) var(--ease)}
.o-opt:active{transform:scale(.99)}
.o-opt input{position:absolute; opacity:0; width:1px; height:1px; pointer-events:none}
.o-opt .o-fi{background:var(--surface-2); box-shadow:none}
.o-opt b{display:block; line-height:1.25}
.o-opt .muted{display:block; font-size:15px; line-height:1.35; margin-top:2px}
.o-radio{width:26px; height:26px; border-radius:50%; box-shadow:inset 0 0 0 2px var(--line-strong); display:grid; place-items:center; color:var(--bg)}
.o-radio .ic{opacity:0}
.o-opt:has(input:checked){box-shadow:inset 0 0 0 2.5px var(--ink)}
.o-opt:has(input:checked) .o-radio{background:var(--ink); box-shadow:none}
.o-opt:has(input:checked) .o-radio .ic{opacity:1}
.o-opt:has(input:focus-visible){outline:3px solid var(--red); outline-offset:2px}
.o-fine{display:flex; gap:8px; align-items:flex-start; font-size:14px; color:var(--muted); margin:0}
.o-fine .ic{margin-top:2px; flex:none}
.o-pickup{display:grid; gap:4px}
.o-preview .core{padding:20px}
.o-preview .label{display:flex; align-items:center; gap:8px; color:var(--muted); font-size:14px; margin-bottom:14px}
.o-preview .o-bubble{margin-bottom:14px}

/* ---------- share ---------- */
.o-done-ic{width:64px; height:64px; border-radius:50%; display:grid; place-items:center; background:var(--ok); color:var(--on-ok); margin-bottom:18px}
.o-linkwrap{display:grid; grid-template-columns:minmax(0,1fr); gap:10px; margin-top:20px}
.o-link{display:flex; align-items:center; gap:10px; min-height:56px; padding:12px 18px; border-radius:20px; background:var(--surface-2); font-weight:700; font-size:16px}
.o-link .ic{color:var(--muted); flex:none}
.o-link output{flex:1; min-width:0; line-height:1.35; overflow-wrap:anywhere}
.nw{white-space:nowrap}
.o-link output{display:flex; min-width:0}
.o-link .o-lh{min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.o-link .nw{flex:none}
.o-orglink .o-h3{display:flex; align-items:center; gap:8px}
.o-orglink .o-h3 .ic{color:var(--muted)}

/* ---------- shared list ---------- */
.o-timer{display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:nowrap}
.o-timer > div:first-child{flex:1; min-width:0}
.o-until{flex:none}
.o-timer .lbl{display:block; font-weight:700; color:var(--muted); font-size:15px}
.o-time{display:block; font-size:48px; font-weight:800; letter-spacing:-.045em; line-height:1; margin-top:6px; font-variant-numeric:tabular-nums}
.o-time small{font-size:20px; letter-spacing:-.02em; margin-left:2px}
.o-until{text-align:right; font-weight:700; line-height:1.35}
.o-until > span:not(.o-live){display:block; color:var(--muted); font-weight:600; font-size:15px}
.o-closed{display:grid; grid-template-columns:44px 1fr; gap:14px; align-items:center}
.o-closed .o-fi{background:var(--surface-2); box-shadow:none}
.o-closed b{display:block; font-size:19px; letter-spacing:-.02em; line-height:1.25}
.o-closed div span{display:block; color:var(--muted); font-weight:600; font-size:15px; margin-top:2px}
.o-until .o-live{margin-bottom:4px}
.o-track{height:6px; border-radius:3px; background:var(--surface-3); overflow:hidden; margin-top:18px}
.o-track span{display:block; height:100%; border-radius:3px; background:var(--ink); transform-origin:left center; transition:transform 1s linear}
.o-live{display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:700; color:var(--ok)}
.o-live i{width:8px; height:8px; border-radius:50%; background:currentColor; animation:oPulse 2s ease-in-out infinite}
@keyframes oPulse{0%,100%{opacity:1; transform:scale(1)} 50%{opacity:.35; transform:scale(.8)}}
.o-people{display:grid}
.o-person{display:grid; grid-template-columns:44px minmax(0,1fr) auto; gap:14px; align-items:start; padding:16px 0}
.o-person + .o-person{border-top:1px solid var(--line)}
.o-person .nm{display:flex; align-items:center; gap:8px; flex-wrap:wrap; font-weight:800; font-size:17px; line-height:1.3; min-height:24px; overflow-wrap:anywhere}
.o-tag{font-size:14px; font-weight:700; line-height:1; padding:5px 9px; border-radius:999px; background:var(--surface-2); color:var(--muted)}
.o-person ul{list-style:none; margin:6px 0 0; padding:0; display:grid; gap:4px}
.o-person li{display:flex; gap:8px; font-size:15px; line-height:1.35; color:var(--muted); font-weight:600}
.o-person li .q{color:var(--ink); font-weight:800; font-variant-numeric:tabular-nums; flex:none}
.o-person .sum{padding-top:1px; text-align:right}
.o-person .sum .price{font-size:18px}
.o-person .acts{display:flex; gap:4px; margin:6px 0 -10px -2px}
.o-person .acts .link{font-size:15px; min-height:48px}
.o-person .acts .link.mutedl{color:var(--muted)}
.o-person.new{animation:oIn 560ms var(--ease) both}
.o-owe{display:grid; gap:0; margin-top:6px}
.o-owe .kv{padding:9px 0}
.o-owe .kv span{font-weight:600}
.o-sendinline{margin-top:6px}
.o-dots{display:inline-flex; gap:4px}
.o-dots i{width:6px; height:6px; border-radius:50%; background:currentColor; animation:tdot 900ms ease-in-out infinite}
.o-dots i:nth-child(2){animation-delay:150ms} .o-dots i:nth-child(3){animation-delay:300ms}

/* ---------- colleague picker ---------- */
.o-invite .core{padding:20px}
.o-invite-h{display:flex; gap:14px; align-items:center}
.o-invite-h .h2{font-size:26px}
.o-pill-time{display:inline-flex; align-items:center; gap:8px; min-height:44px; padding:8px 16px 8px 14px; line-height:1.3; border-radius:22px; background:var(--surface-2); font-weight:700; font-size:15px; font-variant-numeric:tabular-nums}
.o-menu-h{display:grid; gap:12px; margin-bottom:6px}
.o-grp{scroll-margin-top:150px}
.o-grp h3{display:flex; align-items:baseline; gap:8px; margin:26px 0 2px}
.o-item{display:grid; grid-template-columns:64px minmax(0,1fr) auto; gap:14px; align-items:center; padding:12px 0}
.o-item + .o-item{border-top:1px solid var(--line)}
.o-item .pic{width:64px; height:64px; border-radius:18px}
.o-item .nm{display:block; font-weight:700; line-height:1.3}
.o-item .meta{display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:4px}
.o-item.out .nm{color:var(--muted)}
.o-item.out .price{color:var(--muted)}
.o-item .counter output{min-width:24px}
.o-slotempty{width:48px}
.o-mine{display:grid; gap:2px}
.o-mine .kv{font-size:15px; padding:9px 0}
.o-mine .kv span{min-width:0}
@container app (min-width:900px){
  .o-menu .o-items{display:grid; grid-template-columns:1fr 1fr; column-gap:28px}
  .o-menu .o-item + .o-item{border-top:0}
  .o-menu .o-item{border-bottom:1px solid var(--line)}
}

/* ---------- states ---------- */
.o-state{display:grid; grid-template-columns:minmax(0,1fr); justify-items:center; text-align:center; gap:10px; padding:36px 20px 30px}
.o-state .ill{width:88px; height:88px; border-radius:50%; display:grid; place-items:center; background:var(--surface-2); color:var(--ink); margin-bottom:6px}
.o-state .ill.ok{background:var(--ok); color:var(--on-ok)}
.o-state .ill.warn{color:var(--warn)}
.o-state p{margin:0; max-width:36ch}
.o-state .o-actions{width:100%; max-width:360px; margin-top:10px}
.o-sentmeta{display:grid; grid-template-columns:1fr 1fr; gap:8px; width:100%; max-width:420px; margin:10px 0 4px}
.o-sentmeta div{padding:14px; border-radius:var(--r-field); background:var(--surface-2); text-align:left}
.o-sentmeta span{display:block; font-size:14px; color:var(--muted); font-weight:700}
.o-sentmeta b{display:block; font-size:20px; letter-spacing:-.02em; font-variant-numeric:tabular-nums}

/* ---------- subscription, FAQ ---------- */
.o-sub-card .core{padding:22px; display:grid; gap:14px}
.o-sub-card .o-tag{justify-self:start}
.o-faq{display:grid}
.o-faq details{border-top:1px solid var(--line)}
.o-faq details:last-child{border-bottom:1px solid var(--line)}
.o-faq summary{list-style:none; display:flex; justify-content:space-between; align-items:center; gap:12px; min-height:60px; padding:12px 0; font-weight:700; font-size:17px; cursor:pointer}
.o-faq summary::-webkit-details-marker{display:none}
.o-faq summary .ic{transition:transform var(--t-base) var(--ease); color:var(--muted); flex:none}
.o-faq details[open] summary .ic{transform:rotate(180deg)}
.o-faq p{margin:0 0 18px; color:var(--muted); max-width:62ch}
.o-split{display:grid; grid-template-columns:minmax(0,1fr); gap:56px}
