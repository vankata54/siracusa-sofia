# The .env of the live server: /srv/siracusa/shared/.env (mode 600, owner siracusa). Never in git, never in a chat.
# Start: `node scripts/make-env.mjs` makes the file with random staff passwords and keys; then add the lines below that
# it does not write. `node scripts/preflight.mjs` checks the result.

PORT=8787
SITE_URL=https://siracusa-sofia.com
DB_FILE=data/siracusa.db

# behind nginx (deploy/nginx-siracusa.conf): both are a must
COOKIE_SECURE=1
TRUST_PROXY=1
# behind Cloudflare instead: TRUST_PROXY=cloudflare

# staff accounts: made by scripts/make-env.mjs (ADMIN_USER, ADMIN_NAME, ADMIN_PASSWORD, OWNER_PASSWORD, MANAGER_PASSWORD,
# WAITER_PASSWORD, KITCHEN_PASSWORD, DRIVER_PASSWORD, MARKETING_PASSWORD). A changed password applies after a restart.
# The keys it also makes: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (notifications), SECRET_KEY (the two-step sign-in).

# backups (scripts/backup.mjs): where they go off the server. One of the two; the place must be private and in the EU.
# BACKUP_RSYNC=user@host:siracusa-backups
# BACKUP_RSYNC_SSH=-p 23 -i /home/siracusa/.ssh/backup_key
# BACKUP_RCLONE=remote:siracusa-backups
# a file with a long passphrase (mode 600): the copies of the database are encrypted before they leave the server.
# Keep the passphrase also OUTSIDE the server: without it the backups cannot be opened.
# BACKUP_PASSFILE=/srv/siracusa/shared/backup.pass
# how many copies stay on the server (defaults)
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# KEEP_MONTHLY=12

# NEVER on the live server: SMS_DEMO=1 (shows the sign-in code on the screen), SC_PREVIEW_API=1 (test mode),
# TRACK_KEY_REQUIRED=0 (orders open by the number alone).
